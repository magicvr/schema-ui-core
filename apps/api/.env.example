# Application
APP_NAME=schema-ui-core-api
APP_ENV=development

# HTTP server
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s

# Logging: debug | info | warn | error
LOG_LEVEL=info

# --- R2 Authentication (GOAL-005 D-004) ---
# Signing key for short-lived JWT access tokens. REQUIRED in non-development
# environments (startup fails closed when missing). Never commit a real value.
# AUTH_JWT_SECRET=

# Token TTLs: access (short-lived JWT) and refresh (opaque, revocable, stored
# hashed in SQLite).
# AUTH_ACCESS_TTL=15m
# AUTH_REFRESH_TTL=720h

# SQLite database path for the auth store (users + refresh_tokens).
# DB_PATH=./data/schema-ui.db

# Initial password used to seed the `admin` user on first boot (when the users
# table is empty). Dev fallback: "admin". Required/setting in production.
# ADMIN_INITIAL_PASSWORD=

# Explicit opt-in for the static development session fallback. Default false;
# production must never enable this. (Acceptance M9)
# AUTH_DEV_SESSION_ENABLED=false
