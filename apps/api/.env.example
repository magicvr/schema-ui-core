# schema-ui-core API · environment reference (I-008-001 / GOAL-008 S1)
#
# This file is a reference only. The Go API reads process environment variables
# and does not automatically load apps/api/.env. Export values in the shell;
# Docker Compose reads a repo-root .env. Keys mirror
# apps/api/internal/config/config.go. "dev default" applies when unset and
# APP_ENV=development; "production" marks keys REQUIRED with fail-closed
# startup when APP_ENV=production (see cmd/server/main.go).
#
# Do NOT commit real secrets.

# Application ---------------------------------------------------------------
APP_NAME=schema-ui-core-api
# development | production. Drives dev fallbacks vs fail-closed requirements.
APP_ENV=development
# mvp | admin | custom. custom requires APP_MODULES_ENABLED.
APP_PROFILE=mvp
# Optional comma-separated override of the Profile module set. Keep empty to
# use the selected Profile defaults.
APP_MODULES_ENABLED=

# HTTP server ---------------------------------------------------------------
HTTP_ADDR=:25080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s

# Logging: debug | info | warn | error
LOG_LEVEL=info

# --- R2/R3 Authentication (GOAL-005/006) ---
# Access-token signing key. DEV: built-in insecure dev key (logs a warning).
# PRODUCTION: REQUIRED; startup fails closed when missing. Never commit a value.
# AUTH_JWT_SECRET=

# Token TTLs: access (short-lived JWT) and refresh (opaque, revocable, stored
# hashed in SQLite).
# AUTH_ACCESS_TTL=15m
# AUTH_REFRESH_TTL=720h

# SQLite database path.
# DEV default: ./data/schema-ui.db
# PRODUCTION (compose): /app/data/schema-ui.db (named volume mount, see compose.yaml)
# DB_PATH=./data/schema-ui.db

# Initial password seeding the `admin` user on first boot (empty users table).
# DEV: falls back to "admin". PRODUCTION: REQUIRED; startup fails closed when
# missing. Change it and never reuse a default in real deployments.
# ADMIN_INITIAL_PASSWORD=

# Static development session fallback (replaces 401 with a dev identity).
# Default false. PRODUCTION must NEVER enable this. (Acceptance M9)
# AUTH_DEV_SESSION_ENABLED=false
