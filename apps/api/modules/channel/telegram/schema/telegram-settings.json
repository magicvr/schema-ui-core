{
  "meta": {
    "pageId": "telegram-settings",
    "title": "Telegram channel",
    "protocolVersion": "2.7",
    "requiredCapabilities": [
      "app.manifest",
      "app.navigation",
      "permissions.inheritance",
      "actions.page.trigger"
    ]
  },
  "actions": {
    "openTelegramOperator": {
      "type": "navigate",
      "url": "/telegram-settings/operator"
    }
  },
  "body": {
    "type": "section",
    "id": "telegram-settings",
    "children": [
      {
        "type": "custom",
        "id": "telegram-admin-tab",
        "component": "telegram-admin-tab",
        "props": {}
      },
      {
        "type": "section",
        "id": "telegram-operator-entry",
        "children": [
          {
            "type": "text",
            "id": "telegram-operator-entry-description",
            "props": {
              "textKey": "schema.telegram.operator.entryDescription"
            }
          },
          {
            "type": "actionButton",
            "id": "telegram-operator-entry-button",
            "props": {
              "labelKey": "schema.telegram.operator.open",
              "actionId": "openTelegramOperator"
            }
          }
        ]
      }
    ]
  }
}
