{
  "protocolVersion": "2.7",
  "requiredCapabilities": [
    "app.manifest",
    "app.navigation"
  ],
  "app": {
    "appId": "schema-ui-core",
    "name": "Schema UI Core",
    "description": "The schema-ui-core administration workspace."
  },
  "pages": [
    {
      "pageId": "recycle-bin",
      "title": "Recycle bin",
      "schemaUrl": "/api/schema/recycle-bin",
      "route": "/recycle-bin",
      "titleKey": "manifest.title.recycleBin"
    }
  ],
  "navigation": {
    "sidebar": [
      {
        "pageRef": "recycle-bin",
        "label": "Recycle bin",
        "icon": "reaction",
        "visibleWhen": {
          "when": "$context.features.menu_recycle_bin == true"
        },
        "labelKey": "manifest.nav.recycleBin"
      }
    ]
  }
}
