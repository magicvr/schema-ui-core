      {
        "pageRef": "system-monitoring",
        "label": "System monitoring",
        "icon": "activity",
        "visibleWhen": {
          "when": "$context.features.menu_monitoring == true"
        },
        "labelKey": "manifest.nav.systemMonitoring"
      }
    ]
  }
}
