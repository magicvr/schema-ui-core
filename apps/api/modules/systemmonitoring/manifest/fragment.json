{
  "protocolVersion": "2.7",
  "requiredCapabilities": [
    "app.manifest",
    "app.navigation"
  ],
  "app": {
    "appId": "schema-ui-core",
    "name": "Schema UI Core",
    "description": "The schema-ui-core administration workspace."
  },
  "pages": [
    {
      "pageId": "system-monitoring",
