# VP-026 (workspace-026 GOAL-003 D-001): PROCESS-WIDE bounded-entry budget of the
# in-memory cache provider (process-wide total incl. not-yet-swept expired entries;
# FIFO eviction of the globally oldest). Must be a positive integer — invalid values
# fail closed at startup and never degrade to the default.
# CACHE_MAX_ENTRIES=10000

# VP-028 (workspace-028 GOAL-003 D-001): per-subscription buffered-channel capacity
# of the in-memory event-bus provider. When a subscriber's buffer is full, Publish
# blocks until space, ctx cancel, or Stop drains. <= 0 falls back to 64; > 4096
# fails closed at startup.
# EVENTBUS_BUFFER_SIZE=64
