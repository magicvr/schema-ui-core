# schema-ui-core API · env template
#
# Canonical committed template (the only one). Copy to configs/.env
# (gitignored) and fill secrets. Do not add configs/env.example (no leading
# dot) or apps/api/.env.example — config tests reject both.
#
# YAML (configs/config.yaml) is the configuration authority for non-secrets.
# This file supplies secrets and env overrides. Module enablement is YAML-only
# (app.profile / app.modules) — not selected from env.
#
# Runtime: config.Load reads CONFIG_ENV_FILE (default configs/.env; set that
# path in the process environment, not in this file). Already-set process env
# is NEVER overridden. pgtest reads the same configs/.env for PG_TEST_* only.
# Docker Compose injects env itself (see compose.yaml).
#
# Values below are placeholders. NEVER commit real credentials.

# Required for non-development startup (fail-closed when missing):
AUTH_JWT_SECRET=
ADMIN_INITIAL_PASSWORD=

# ---------------------------------------------------------------- loader
# Optional path to the operator YAML (default configs/config.yaml).
# CONFIG_FILE=configs/config.yaml

# ---------------------------------------------------------------- application
# APP_NAME=schema-ui-core-api
# development | production | test. Must be set (process env or this file);
# unset fails closed.
# APP_ENV=development
# HTTP_ADDR=:25080
# HTTP_READ_TIMEOUT=5s
# HTTP_WRITE_TIMEOUT=10s
# HTTP_IDLE_TIMEOUT=60s
# Graceful-shutdown drain budget (VP-021 contract v0.1.0 §6). Default 10s;
# unparsable or <=0 values fail closed at startup.
# HTTP_SHUTDOWN_TIMEOUT=10s
# Optional CORS allow-list (comma-separated). Empty = no CORS headers.
# HTTP_CORS_ORIGINS=
# Reverse-proxy CIDRs trusted for X-Real-IP (comma-separated). Empty = loopback only.
# HTTP_TRUSTED_PROXIES=172.16.0.0/12
# LOG_LEVEL=info
# Operational mode: normal | maintenance | degraded | read-only.
# RUNTIME_MODE=normal
# Full navigation order (comma-separated NodeIDs). Empty = built-in default.
# NAVIGATION_ORDER=

# ---------------------------------------------------------------- authentication
# Optional previous signing key for a JWT rotation overlap window (VP-016).
# AUTH_JWT_SECRET_PREVIOUS=
# AUTH_ACCESS_TTL=15m
# AUTH_REFRESH_TTL=720h
# Static development session fallback. Default false. PRODUCTION must NEVER enable this.
# AUTH_DEV_SESSION_ENABLED=false
# Canonical external origin for emailed invitation links (W13 F-006). When set,
# links always use it instead of the request Host/X-Forwarded-Proto headers.
# Absolute origin only, e.g. https://ops.example.com (no path/query/fragment).
# AUTH_PUBLIC_BASE_URL=

# SQLite path (ignored when db.dialect=postgres).
# DEV default: ./data/schema-ui.db
# PRODUCTION (compose): /app/data/schema-ui.db
# DB_PATH=./data/schema-ui.db

# ---------------------------------------------------------------- upload / branding
# Upload MIME allow-list and per-user caps (YAML upload.* remains authoritative).
# UPLOAD_ALLOWED_TYPES=
# UPLOAD_MAX_FILES_PER_USER=1000
# UPLOAD_MAX_BYTES_PER_USER=268435456
# Brand-asset processing (YAML branding.* remains authoritative).
# BRANDING_MAX_BYTES=4194304
# BRANDING_LOGO_MAX_DIMENSION=512
# BRANDING_FAVICON_DIMENSION=64
# BRANDING_JPEG_QUALITY=82

# ---------------------------------------------------------------- postgres runtime
# Store dialect: sqlite (default) | postgres
# DB_DIALECT=postgres
# Postgres address + credentials: host/port/user/password are env-only; the
# database NAME belongs in configs/config.yaml (db: name:) as the stable,
# non-secret setting. Never put the password in config.yaml.
# DB_HOST=your-db-host.example.internal
# DB_PORT=5432
# DB_NAME=schema_ui
# DB_USER=your_db_user
# DB_PASSWORD=replace-with-a-strong-password
# DB_SSLMODE=require
# Connection-pool bounds (0 = driver default / no cap).
# DB_POOL_MAX_OPEN=20
# DB_POOL_MAX_IDLE=5
# DB_CONN_MAX_LIFETIME=30m
# Optional: whole postgres DSN override (wins over the exploded params above).
# DB_DSN=postgres://user:password@host:5432/schema_ui?sslmode=require

# ---------------------------------------------------------------- postgres integration tests
# When these are set, the postgres-gated tests run against your local postgres
# (they SKIP cleanly when unset, so plain `go test ./...` keeps working with
# sqlite only). The tests create and drop their own scratch databases, so the
# account needs CREATEDB (a superuser works). pgtest loads only PG_TEST_* from
# this file.
# PG_TEST_HOST=localhost
# PG_TEST_PORT=5432
# PG_TEST_USER=postgres
# PG_TEST_PASSWORD=replace-with-your-local-test-password
# PG_TEST_DB=postgres
# PG_TEST_SSLMODE=disable
# Optional: full DSN, overrides the exploded PG_TEST_* params.
# PG_TEST_DSN=

# ---------------------------------------------------------------- object storage
# Kernel object-storage driver (VP-014): local (default) | s3. driver=s3
# requires endpoint/bucket/access_key_id/secret_access_key and extends readyz.
# STORAGE_OBJECTS_DRIVER=s3
# STORAGE_OBJECTS_S3_ENDPOINT=http://minio:9000
# STORAGE_OBJECTS_S3_REGION=us-east-1
# STORAGE_OBJECTS_S3_BUCKET=schema-ui
# STORAGE_OBJECTS_S3_ACCESS_KEY_ID=replace-with-your-access-key
# STORAGE_OBJECTS_S3_SECRET_ACCESS_KEY=replace-with-a-strong-secret
# STORAGE_OBJECTS_S3_USE_PATH_STYLE=true
# Optional: override the derived local disk root (default = db.path dir).
# STORAGE_OBJECTS_LOCAL_ROOT=/var/lib/schema-ui/objects

# ---------------------------------------------------------------- observability
# VP-015. All observability surfaces are OFF by default: no extra ports, no
# collector required (mvp/dev/Compose default).
# Metrics: dedicated Prometheus exposition listener (separate from the main
# mux). Non-loopback binds REQUIRE auth_token in every environment.
# OBSERVABILITY_METRICS_ENABLED=true
# OBSERVABILITY_METRICS_ADDR=127.0.0.1:25081
# OBSERVABILITY_METRICS_AUTH_TOKEN=replace-with-a-16-plus-char-token
# Traces: OTLP/HTTP export (endpoint required when enabled; export failures
# are logged, never fatal). Sample ratio in (0,1].
# OBSERVABILITY_TRACES_ENABLED=true
# OBSERVABILITY_TRACES_ENDPOINT=http://localhost:4318
# OBSERVABILITY_TRACES_SAMPLE_RATIO=1.0

# ---------------------------------------------------------------- outbound mail
# VP-017. All keys empty (default) = SMTP unconfigured: sending uses the
# embedded capture/log sink, startup unaffected. Setting ANY key makes
# host/username/password/from REQUIRED (fail-closed at startup); port
# defaults to 465. Only dial shape: implicit TLS + verification.
# MAIL_SMTP_HOST=smtp.example.com
# MAIL_SMTP_PORT=465
# MAIL_SMTP_USERNAME=api@example.com
# MAIL_SMTP_PASSWORD=replace-with-a-strong-secret
# MAIL_SMTP_FROM=no-reply@example.com

# VP-017 R6 (GOAL-006 D-002): explicit channel selector + production Resend
# HTTP API channel. channel: mock | resend | smtp; empty derives (one fully
# configured production block wins; both -> startup fails closed until you
# pick). Touching ANY mail.resend key makes api-key/from REQUIRED
# (fail-closed). api-key is a SECRET: env / this file only, never YAML.
# MAIL_CHANNEL=resend
# MAIL_RESEND_API_KEY=re_replace-with-a-strong-secret
# MAIL_RESEND_FROM=no-reply@example.com
# Optional passphrase for the local master key that encrypts admin-entered
# channel secrets at rest (R7). Empty = auto-generated key file in data/.
# MAIL_CONFIG_MASTER_KEY=replace-with-a-strong-passphrase
# Optional relocation of the auto-generated master key FILE (W13 F-017).
# Default keeps it beside the sqlite data dir — one backup then leaks both
# the ciphertext and its key; point this at a separate volume to split them.
# MAIL_MASTER_KEY_PATH=

# VP-026 (workspace-026 GOAL-003 D-001): bounded-entry budget of the in-memory
# cache provider (process-wide total incl. not-yet-swept expired entries; FIFO
# eviction of the globally oldest). Must be a positive integer — invalid values
# fail closed at startup and never degrade to the default.
# CACHE_MAX_ENTRIES=10000
