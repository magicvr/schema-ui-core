# schema-ui-core API · secrets reference (W7 / GOAL-008)
#
# Copy to configs/.env and fill in the SECRET values only. The YAML file is
# the configuration authority; this file only supplies the sensitive values
# referenced by ${VAR} / ${VAR:-default} in configs/config.yaml.
#
# The API reads this file only when CONFIG_ENV_FILE points at it (default
# ./configs/.env). Existing process environment variables are NEVER
# overridden. Docker Compose deployments ignore this file: compose injects
# the environment itself (see compose.yaml, fail-closed ${VAR:?...}).
#
# Never commit real secrets.

# Required for non-development startup (fail-closed when missing):
AUTH_JWT_SECRET=
ADMIN_INITIAL_PASSWORD=

# Optional overrides — anything here may also come from process env.
# AUTH_ACCESS_TTL=15m
# AUTH_REFRESH_TTL=720h
# AUTH_DEV_SESSION_ENABLED=false
# UPLOAD_ALLOWED_TYPES=
# UPLOAD_MAX_FILES_PER_USER=1000
# UPLOAD_MAX_BYTES_PER_USER=268435456
