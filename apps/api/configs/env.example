# Copy to apps/api/configs/.env (gitignored — see apps/api/.gitignore: .env)
# and fill in your local values. Not committed.
#
# Loaded at runtime by config.Load (DB_*) — and, for integration tests, by
# internal/pgtest (PG_TEST_*) which reads this file so tests get the postgres
# connection without a shell wrapper. CI sets the same variables directly.

# ---------------------------------------------------------------- application
# Store dialect: sqlite (default) | postgres
# DB_DIALECT=postgres
# Postgres address + credentials: host/port/user/password are env-only; the
# database NAME belongs in configs/config.yaml (db: name:) as the stable,
# non-secret setting. Never put the password in config.yaml.
# DB_HOST=192.168.31.213
# DB_PORT=5432
# DB_NAME=schema_ui
# DB_USER=sa
# DB_PASSWORD=Ss.110110
# DB_SSLMODE=disable
# Optional: whole postgres DSN override (wins over the exploded params above).
# DB_DSN=postgres://sa:Ss.110110@192.168.31.213:5432/schema_ui?sslmode=disable

# ------------------------------------------------- postgres integration tests
# When these are set, the postgres-gated tests run against your local postgres
# (they SKIP cleanly when unset, so plain `go test ./...` keeps working with
# sqlite only). The tests create and drop their own scratch databases, so the
# account needs CREATEDB (a superuser works).
# PG_TEST_HOST=192.168.31.213
# PG_TEST_PORT=5432
# PG_TEST_USER=sa
# PG_TEST_PASSWORD=Ss.110110
# PG_TEST_DB=postgres
# PG_TEST_SSLMODE=disable
# Optional: full DSN, overrides the exploded PG_TEST_* params.
# PG_TEST_DSN=
