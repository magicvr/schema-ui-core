{
  "meta": {
    "pageId": "search-form-table",
    "title": "Search + table",
    "protocolVersion": "2.7",
    "requiredCapabilities": ["app.manifest", "app.navigation", "form.controls.extended", "table.sort"]
  },
  "body": {
    "type": "section",
    "props": { "title": "Search + table" },
    "children": [
      {
        "type": "text",
        "props": {
          "text": "A search form filters the role list (D-TABLE search-table); column headers declare sort (D-TABLE table-sort). R4 binds the search form to the target table query (form-to-query, mode: search + targetTable)."
        }
      },
      {
        "type": "form",
        "id": "search-form",
        "props": {
          "fields": [{ "id": "q", "label": "Search roles", "type": "input" }],
          "mode": "search",
          "targetTable": "search-results",
          "submitLabel": "Search"
        }
      },
      {
        "type": "table",
        "id": "search-results",
        "props": {
          "columns": [
            { "field": "id", "label": "ID" },
            { "field": "key", "label": "Key", "sortable": true },
            { "field": "name", "label": "Name", "sortable": true },
            { "field": "updatedAt", "label": "Updated", "sortable": true }
          ],
          "dataSource": "/api/roles"
        }
      }
    ]
  }
}
