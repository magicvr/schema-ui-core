{
  "meta": {
    "pageId": "list-edit-lifecycle",
    "title": "List + edit lifecycle",
    "protocolVersion": "2.7",
    "requiredCapabilities": [
      "app.manifest",
      "app.navigation",
      "permissions.inheritance",
      "actions.row.request",
      "actions.page.trigger",
      "table.sort"
    ]
  },
  "actions": {
    "createRecord": {
      "type": "request",
      "method": "POST",
      "url": "/api/records",
      "bodyMapping": { "name": "name", "status": "status", "owner": "owner" },
      "onSuccess": { "behavior": "reload" }
    },
    "updateRecord": {
      "type": "request",
      "method": "PATCH",
      "url": "/api/records/{id}",
      "bodyMapping": { "name": "name", "status": "status", "owner": "owner" },
      "onSuccess": { "behavior": "reload" }
    },
    "deleteRecord": {
      "type": "request",
      "method": "DELETE",
      "url": "/api/records/{id}",
      "onSuccess": { "behavior": "reload" }
    },
    "openCreate": {
      "type": "modal",
      "content": {
        "type": "form",
        "id": "create-form",
        "permissionCascade": { "keys": ["edit"] },
        "permissions": {
          "edit": "$context.user.permissions contains \"records.write\""
        },
        "props": {
          "fields": [
            { "id": "name", "label": "Name", "type": "input" },
            {
              "id": "status",
              "label": "Status",
              "type": "select",
              "options": [
                { "value": "active", "label": "Active" },
                { "value": "pending", "label": "Pending" },
                { "value": "archived", "label": "Archived" }
              ]
            },
            { "id": "owner", "label": "Owner", "type": "input" }
          ],
          "submitAction": "createRecord",
          "submitLabel": "Create record"
        }
      }
    },
    "openEdit": {
      "type": "modal",
      "content": {
        "type": "form",
        "id": "edit-form",
        "permissionCascade": { "keys": ["edit"] },
        "permissions": {
          "edit": "$context.user.permissions contains \"records.write\""
        },
        "props": {
          "fields": [
            { "id": "name", "label": "Name", "type": "input" },
            {
              "id": "status",
              "label": "Status",
              "type": "select",
              "options": [
                { "value": "active", "label": "Active" },
                { "value": "pending", "label": "Pending" },
                { "value": "archived", "label": "Archived" }
              ]
            },
            { "id": "owner", "label": "Owner", "type": "input" }
          ],
          "submitAction": "updateRecord",
          "submitLabel": "Save changes"
        }
      }
    }
  },
  "body": {
    "type": "section",
    "id": "records",
    "children": [
      {
        "type": "table",
        "id": "records-table",
        "permissionCascade": { "keys": ["edit", "delete"] },
        "permissions": {
          "edit": "$context.user.permissions contains \"records.write\"",
          "delete": "$context.user.permissions contains \"records.write\""
        },
        "props": {
          "columns": [
            { "field": "id", "label": "ID" },
            { "field": "name", "label": "Name", "sortable": true },
            { "field": "status", "label": "Status", "sortable": true },
            { "field": "owner", "label": "Owner", "sortable": true },
            { "field": "updatedAt", "label": "Updated", "sortable": true }
          ],
          "dataSource": "/api/records",
          "toolbar": [
            {
              "key": "create",
              "label": "New record",
              "actionRef": "openCreate",
              "permissionIntent": "edit"
            }
          ],
          "actions": [
            {
              "key": "edit",
              "label": "Edit",
              "actionRef": "openEdit",
              "permissionIntent": "edit"
            },
            {
              "key": "delete",
              "label": "Delete",
              "actionRef": "deleteRecord",
              "permissionIntent": "delete",
              "requestMapping": { "path": { "id": "$row.id" } },
              "confirm": "Delete this record?"
            }
          ]
        }
      },
      {
        "type": "recordView",
        "id": "record-detail",
        "props": {}
      }
    ]
  }
}
