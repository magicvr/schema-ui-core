{
  "meta": {
    "pageId": "notifications",
    "title": "Notifications",
    "protocolVersion": "2.7",
    "requiredCapabilities": [
      "app.manifest",
      "app.navigation",
      "permissions.inheritance",
      "actions.page.trigger",
      "actions.row.request",
      "form.record.load",
      "form.controls.extended"
    ]
  },
  "actions": {
    "markAllRead": {
      "type": "request",
      "method": "POST",
      "url": "/api/notifications/read-all",
      "onSuccess": {
        "behavior": "reload"
      }
    },
    "saveSettings": {
      "type": "request",
      "method": "PATCH",
      "url": "/api/notifications/settings",
      "bodyMapping": {
        "enabled": "enabled"
      },
      "onSuccess": {
        "behavior": "reload"
      }
    }
  },
  "body": {
    "type": "section",
    "id": "notifications",
    "children": [
      {
        "type": "form",
        "id": "notifications-search",
        "props": {
          "mode": "search",
          "targetTable": "notifications-table",
          "fields": [
            {
              "id": "q",
              "labelKey": "schema.notifications.search.q",
              "type": "input"
            },
            {
              "id": "read",
              "type": "select",
              "labelKey": "schema.notifications.filter.read",
              "options": [
                {
                  "value": "",
                  "labelKey": "schema.notifications.filter.read.all"
                },
                {
                  "value": "unread",
                  "labelKey": "schema.notifications.filter.read.unread"
                },
                {
                  "value": "read",
                  "labelKey": "schema.notifications.filter.read.read"
                }
              ]
            }
          ],
          "submitLabelKey": "feedback.search"
        }
      },
      {
        "type": "form",
        "id": "notification-settings",
        "props": {
          "title": "Notification settings",
          "titleKey": "schema.notifications.settings.title",
          "recordSource": {
            "method": "GET",
            "url": "/api/notifications/settings",
            "responseMapping": {
              "enabled": "enabled"
            }
          },
          "fields": [
            {
              "id": "enabled",
              "label": "Enable in-app notifications",
              "type": "select",
              "options": [
                {
                  "value": "true",
                  "label": "Enabled",
                  "labelKey": "schema.notifications.settings.enabled"
                },
                {
                  "value": "false",
                  "label": "Disabled",
                  "labelKey": "schema.notifications.settings.disabled"
                }
              ],
              "labelKey": "schema.notifications.settings.enable"
            }
          ],
          "submitAction": "saveSettings",
          "submitLabel": "Save settings",
          "submitLabelKey": "schema.notifications.settings.submit"
        }
      },
      {
        "type": "custom",
        "id": "notifications-center",
        "component": "notification-center",
        "props": {
          "targetTable": "notifications-table"
        }
      }
    ]
  }
}
