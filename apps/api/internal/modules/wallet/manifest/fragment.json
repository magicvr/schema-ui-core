{
  "protocolVersion": "2.7",
  "requiredCapabilities": [
    "app.manifest",
    "app.navigation"
  ],
  "app": {
    "appId": "schema-ui-core",
    "name": "Schema UI Core",
    "description": "The schema-ui-core administration workspace."
  },
  "pages": [
    {
      "pageId": "wallet",
      "title": "Wallet",
      "schemaUrl": "/api/schema/wallet",
      "route": "/wallet",
      "titleKey": "manifest.title.wallet"
    },
    {
      "pageId": "wallet-entries",
      "title": "Wallet entries",
      "schemaUrl": "/api/schema/wallet-entries",
      "route": "/wallet-entries/{id}",
      "titleKey": "manifest.title.walletEntries"
    }
  ],
  "navigation": {
    "sidebar": [
      {
        "pageRef": "wallet",
        "label": "Wallet",
        "icon": "wallet",
        "visibleWhen": {
          "when": "$context.features.menu_wallet == true"
        },
        "labelKey": "manifest.nav.wallet"
      }
    ]
  }
}
