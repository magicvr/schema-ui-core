{
  "meta": {
    "pageId": "wallet",
    "title": "Wallet",
    "protocolVersion": "2.9",
    "requiredCapabilities": [
      "app.manifest",
      "app.navigation",
      "permissions.inheritance",
      "actions.row.request",
      "actions.page.trigger",
      "actions.row.navigate",
      "table.sort",
      "form.controls.extended",
      "form.controls.advanced",
      "form.controls.readonly"
    ]
  },
  "actions": {
    "createAccount": {
      "type": "request",
      "method": "POST",
      "url": "/api/wallet/accounts",
      "bodyMapping": {
        "ownerType": "ownerType",
        "ownerId": "ownerId",
        "currency": "currency"
      },
      "onSuccess": { "behavior": "reload" }
    },
    "updateStatus": {
      "type": "request",
      "method": "PATCH",
      "url": "/api/wallet/accounts/{id}",
      "bodyMapping": { "status": "status", "version": "version" },
      "onSuccess": { "behavior": "reload" }
    },
    "adjust": {
      "type": "request",
      "method": "POST",
      "url": "/api/wallet/accounts/{id}/adjust",
      "bodyMapping": { "amountDelta": "amountDelta", "memo": "memo", "idempotencyKey": "idempotencyKey" },
      "onSuccess": { "behavior": "reload" }
    },
    "freeze": {
      "type": "request",
      "method": "POST",
      "url": "/api/wallet/accounts/{id}/freeze",
      "bodyMapping": { "amount": "amount", "memo": "memo", "idempotencyKey": "idempotencyKey" },
      "onSuccess": { "behavior": "reload" }
    },
    "unfreeze": {
      "type": "request",
      "method": "POST",
      "url": "/api/wallet/accounts/{id}/unfreeze",
      "bodyMapping": { "amount": "amount", "memo": "memo", "idempotencyKey": "idempotencyKey" },
      "onSuccess": { "behavior": "reload" }
    },
    "runReconcile": {
      "type": "request",
      "method": "POST",
      "url": "/api/wallet/reconcile",
      "onSuccess": { "behavior": "reload" }
    },
    "openCreate": {
      "type": "modal",
      "content": {
        "type": "form",
        "id": "create-wallet-form",
        "permissionCascade": { "keys": ["edit"] },
        "permissions": { "edit": "$context.user.permissions contains \"wallet.write\"" },
        "props": {
          "fields": [
            {
              "id": "ownerType", "label": "Owner type", "type": "select", "required": true,
              "options": [
                { "value": "business", "label": "Business", "labelKey": "schema.wallet.owner.business" },
                { "value": "system", "label": "System", "labelKey": "schema.wallet.owner.system" }
              ],
              "labelKey": "schema.wallet.field.ownerType"
            },
            { "id": "ownerId", "label": "Owner ID", "type": "input", "required": true, "labelKey": "schema.wallet.field.ownerId" },
            { "id": "currency", "label": "Currency", "type": "input", "defaultValue": "CNY", "labelKey": "schema.wallet.field.currency" }
          ],
          "submitAction": "createAccount",
          "submitLabel": "Create account",
          "submitLabelKey": "schema.wallet.submit.create"
        }
      }
    },
    "openAdjust": {
      "type": "modal",
      "content": {
        "type": "form",
        "id": "adjust-wallet-form",
        "permissionCascade": { "keys": ["edit"] },
        "permissions": { "edit": "$context.user.permissions contains \"wallet.adjust\"" },
        "props": {
          "fields": [
            { "id": "amountDelta", "label": "Amount (signed, min units)", "type": "inputNumber", "required": true, "labelKey": "schema.wallet.field.amountDelta" },
            { "id": "memo", "label": "Memo", "type": "textarea", "required": true, "labelKey": "schema.wallet.field.memo" },
            { "id": "idempotencyKey", "label": "Idempotency key (optional)", "type": "input", "labelKey": "schema.wallet.field.idempotencyKey" }
          ],
          "submitAction": "adjust",
          "submitLabel": "Adjust balance",
          "submitLabelKey": "schema.wallet.submit.adjust"
        }
      }
    },
    "openFreeze": {
      "type": "modal",
      "content": {
        "type": "form",
        "id": "freeze-wallet-form",
        "permissionCascade": { "keys": ["edit"] },
        "permissions": { "edit": "$context.user.permissions contains \"wallet.adjust\"" },
        "props": {
          "fields": [
            { "id": "amount", "label": "Amount (min units)", "type": "inputNumber", "required": true, "labelKey": "schema.wallet.field.amount" },
            { "id": "memo", "label": "Memo", "type": "textarea", "required": true, "labelKey": "schema.wallet.field.memo" },
            { "id": "idempotencyKey", "label": "Idempotency key (optional)", "type": "input", "labelKey": "schema.wallet.field.idempotencyKey" }
          ],
          "submitAction": "freeze",
          "submitLabel": "Freeze",
          "submitLabelKey": "schema.wallet.submit.freeze"
        }
      }
    },
    "openUnfreeze": {
      "type": "modal",
      "content": {
        "type": "form",
        "id": "unfreeze-wallet-form",
        "permissionCascade": { "keys": ["edit"] },
        "permissions": { "edit": "$context.user.permissions contains \"wallet.adjust\"" },
        "props": {
          "fields": [
            { "id": "amount", "label": "Amount (min units)", "type": "inputNumber", "required": true, "labelKey": "schema.wallet.field.amount" },
            { "id": "memo", "label": "Memo", "type": "textarea", "required": true, "labelKey": "schema.wallet.field.memo" },
            { "id": "idempotencyKey", "label": "Idempotency key (optional)", "type": "input", "labelKey": "schema.wallet.field.idempotencyKey" }
          ],
          "submitAction": "unfreeze",
          "submitLabel": "Unfreeze",
          "submitLabelKey": "schema.wallet.submit.unfreeze"
        }
      }
    },
    "openStatus": {
      "type": "modal",
      "content": {
        "type": "form",
        "id": "status-wallet-form",
        "permissionCascade": { "keys": ["edit"] },
        "permissions": { "edit": "$context.user.permissions contains \"wallet.write\"" },
        "props": {
          "fields": [
            {
              "id": "status", "label": "Status", "type": "select", "required": true,
              "options": [
                { "value": "active", "label": "Active", "labelKey": "schema.wallet.status.active" },
                { "value": "disabled", "label": "Disabled", "labelKey": "schema.wallet.status.disabled" }
              ],
              "labelKey": "schema.wallet.field.status"
            },
            { "id": "version", "label": "Version", "type": "inputNumber", "readOnly": true, "labelKey": "schema.wallet.field.version" }
          ],
          "submitAction": "updateStatus",
          "submitLabel": "Save status",
          "submitLabelKey": "schema.wallet.submit.status"
        }
      }
    },
    "openEntries": { "type": "navigate", "url": "/wallet-entries/{id}" }
  },
  "body": {
    "type": "section",
    "id": "wallet",
    "children": [
      {
        "type": "form",
        "id": "wallet-search",
        "props": {
          "mode": "search",
          "targetTable": "wallet-table",
          "fields": [{ "id": "q", "label": "Search", "type": "input", "labelKey": "feedback.search" }],
          "submitLabel": "Search",
          "submitLabelKey": "feedback.search"
        }
      },
      {
        "type": "table",
        "id": "wallet-table",
        "permissionCascade": { "keys": ["edit"] },
        "permissions": {
          "edit": "$context.user.permissions contains \"wallet.adjust\""
        },
        "props": {
          "columns": [
            { "field": "ownerType", "label": "Owner type", "sortable": true, "labelKey": "schema.wallet.column.ownerType" },
            { "field": "ownerId", "label": "Owner ID", "sortable": true, "labelKey": "schema.wallet.column.ownerId" },
            { "field": "currency", "label": "Currency", "labelKey": "schema.wallet.column.currency" },
            { "field": "balanceTotal", "label": "Balance", "sortable": true, "labelKey": "schema.wallet.column.balanceTotal" },
            { "field": "balanceAvailable", "label": "Available", "labelKey": "schema.wallet.column.balanceAvailable" },
            { "field": "balanceFrozen", "label": "Frozen", "labelKey": "schema.wallet.column.balanceFrozen" },
            { "field": "status", "label": "Status", "labelKey": "schema.wallet.column.status" },
            { "field": "updatedAt", "label": "Updated", "sortable": true, "labelKey": "schema.wallet.column.updated" }
          ],
          "dataSource": "/api/wallet/accounts",
          "toolbar": [
            { "key": "create", "label": "New account", "actionRef": "openCreate", "permissionIntent": "edit", "labelKey": "schema.wallet.toolbar.create" },
            { "key": "reconcile", "label": "Reconcile", "actionRef": "runReconcile", "labelKey": "schema.wallet.toolbar.reconcile" }
          ],
          "actions": [
            { "key": "entries", "label": "Entries", "actionRef": "openEntries", "navigateMapping": { "path": { "id": "$row.id" } }, "labelKey": "schema.wallet.action.entries" },
            { "key": "adjust", "label": "Adjust", "actionRef": "openAdjust", "permissionIntent": "edit", "labelKey": "schema.wallet.action.adjust" },
            { "key": "freeze", "label": "Freeze", "actionRef": "openFreeze", "permissionIntent": "edit", "labelKey": "schema.wallet.action.freeze" },
            { "key": "unfreeze", "label": "Unfreeze", "actionRef": "openUnfreeze", "permissionIntent": "edit", "labelKey": "schema.wallet.action.unfreeze" },
            { "key": "status", "label": "Status", "actionRef": "openStatus", "permissionIntent": "edit", "labelKey": "schema.wallet.action.status" }
          ]
        }
      }
    ]
  }
}