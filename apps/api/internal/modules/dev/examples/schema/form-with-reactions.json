{
  "meta": {
    "pageId": "form-with-reactions",
    "title": "Form with reactions",
    "protocolVersion": "2.7",
    "requiredCapabilities": [
      "app.manifest",
      "app.navigation",
      "form.controls.extended"
    ]
  },
  "body": {
    "type": "section",
    "props": {
      "title": "Form with reactions"
    },
    "children": [
      {
        "type": "text",
        "props": {
          "text": "D-EXPR reactions reuse the frozen $context expression engine to flip field visibility / disabled state.",
          "textKey": "schema.form-with-reactions.text.intro"
        }
      },
      {
        "type": "form",
        "id": "reactive-form",
        "props": {
          "fields": [
            {
              "id": "name",
              "label": "Name (input)",
              "type": "input",
              "labelKey": "schema.form-with-reactions.field.name"
            },
            {
              "id": "kind",
              "label": "Kind (select)",
              "type": "select",
              "options": [
                {
                  "value": "standard",
                  "label": "Standard",
                  "labelKey": "schema.form-with-reactions.option.standard"
                },
                {
                  "value": "priority",
                  "label": "Priority",
                  "labelKey": "schema.form-with-reactions.option.priority"
                }
              ],
              "labelKey": "schema.form-with-reactions.field.kind"
            },
            {
              "id": "approval",
              "label": "Approval (switch)",
              "type": "switch",
              "labelKey": "schema.form-with-reactions.field.approval"
            },
            {
              "id": "auditNote",
              "label": "Audit note (textarea)",
              "type": "textarea",
              "labelKey": "schema.form-with-reactions.field.auditNote"
            }
          ],
          "reactions": [
            {
              "id": "admin-approval",
              "when": "$context.user.roles contains \"admin\"",
              "apply": [
                {
                  "fieldId": "approval",
                  "visible": true
                }
              ]
            },
            {
              "id": "viewer-approval",
              "when": "$context.user.roles contains \"viewer\"",
              "apply": [
                {
                  "fieldId": "approval",
                  "visible": false
                }
              ]
            },
            {
              "id": "audit-lock",
              "when": "$context.features.audit != true",
              "apply": [
                {
                  "fieldId": "auditNote",
                  "disabled": true
                }
              ]
            }
          ],
          "submitLabel": "Submit",
          "submitLabelKey": "schema.form-with-reactions.submit.submit"
        }
      }
    ]
  }
}
