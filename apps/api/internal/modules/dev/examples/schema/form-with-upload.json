{
  "meta": {
    "pageId": "form-with-upload",
    "title": "Form with upload",
    "protocolVersion": "2.7",
    "requiredCapabilities": [
      "app.manifest",
      "app.navigation",
      "actions.upload",
      "form.controls.extended"
    ]
  },
  "actions": {
    "uploadAttachment": {
      "type": "upload",
      "url": "/api/upload",
      "multiple": false,
      "onSuccess": {
        "behavior": "toast",
        "message": "上传成功"
      }
    }
  },
  "body": {
    "type": "section",
    "props": {
      "title": "Form with upload"
    },
    "children": [
      {
        "type": "text",
        "props": {
          "text": "ADR-0012 upload orchestration: selecting a file validates (accept/maxSize/multiple) and uploads each file as multipart; the field value takes the response url (preferred) or id.",
          "textKey": "schema.form-with-upload.text.intro"
        }
      },
      {
        "type": "form",
        "id": "upload-form",
        "props": {
          "fields": [
            {
              "id": "title",
              "label": "Title (input)",
              "type": "input",
              "labelKey": "schema.form-with-upload.field.title"
            },
            {
              "id": "attachment",
              "label": "Attachment (upload)",
              "type": "upload",
              "actionRef": "uploadAttachment",
              "labelKey": "schema.form-with-upload.field.attachment"
            }
          ],
          "submitLabel": "Submit",
          "submitLabelKey": "schema.form-with-upload.submit.submit"
        }
      }
    ]
  }
}
