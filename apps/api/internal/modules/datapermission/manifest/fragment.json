      {
        "pageRef": "data-permission",
        "label": "Data permission",
        "icon": "shield",
        "visibleWhen": {
          "when": "$context.features.menu_data_permission == true"
        },
        "labelKey": "manifest.nav.dataPermission"
      }
    ]
  }
}
