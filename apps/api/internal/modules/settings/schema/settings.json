{
  "meta": {
    "pageId": "settings",
    "title": "Settings",
    "protocolVersion": "2.7",
    "requiredCapabilities": [
      "app.manifest",
      "app.navigation",
      "permissions.inheritance",
      "actions.page.trigger",
      "form.record.load",
      "form.controls.extended",
      "actions.upload"
    ]
  },
  "actions": {
    "updateGeneral": {
      "type": "request",
      "method": "PATCH",
      "url": "/api/settings/default",
      "bodyMapping": {
        "siteTitle": "siteTitle",
        "copyrightText": "copyrightText",
        "icpNumber": "icpNumber"
      },
      "onSuccess": {
        "behavior": "reload"
      }
    },
    "updateBranding": {
      "type": "request",
      "method": "PATCH",
      "url": "/api/settings/default",
      "bodyMapping": {
        "logoUrl": "logoUrl",
        "logoUrlLight": "logoUrlLight",
        "logoUrlDark": "logoUrlDark",
        "faviconUrl": "faviconUrl"
      },
      "onSuccess": {
        "behavior": "reload"
      }
    },
    "uploadBrandingLogo": {
      "type": "upload",
      "url": "/api/branding/assets?kind=logo",
      "multiple": false,
      "accept": "image/png,image/jpeg,image/webp",
      "maxSize": 4194304
    },
    "uploadBrandingFavicon": {
      "type": "upload",
      "url": "/api/branding/assets?kind=favicon",
      "multiple": false,
      "accept": "image/png,image/jpeg,image/webp",
      "maxSize": 4194304
    },
    "updateLocalization": {
      "type": "request",
      "method": "PATCH",
      "url": "/api/settings/default",
      "bodyMapping": {
        "defaultLocale": "defaultLocale",
        "siteTimezone": "siteTimezone"
      },
      "onSuccess": {
        "behavior": "reload"
      }
    },
    "updateAppearance": {
      "type": "request",
      "method": "PATCH",
      "url": "/api/settings/default",
      "bodyMapping": {
        "defaultTheme": "defaultTheme"
      },
      "onSuccess": {
        "behavior": "reload"
      }
    },
    "updateAudit": {
      "type": "request",
      "method": "PATCH",
      "url": "/api/settings/default",
      "bodyMapping": {
        "operationLogRetentionDays": "operationLogRetentionDays",
        "operationLogExpirationAction": "operationLogExpirationAction"
      },
      "onSuccess": {
        "behavior": "reload"
      }
    },
    "resetSettings": {
      "type": "request",
      "method": "POST",
      "url": "/api/settings/default/reset",
      "onSuccess": {
        "behavior": "reload"
      }
    },
    "updateCaptcha": {
      "type": "request",
      "method": "PATCH",
      "url": "/api/captcha/settings",
      "bodyMapping": {
        "enabled": "enabled"
      }
    },
    "updateMail": {
      "type": "request",
      "method": "PUT",
      "url": "/api/mail/config",
      "bodyMapping": {
        "channel": "channel",
        "mockRetention": "mockRetention",
        "resendApiKey": "resendApiKey",
        "resendFrom": "resendFrom",
        "smtpHost": "smtpHost",
        "smtpPort": "smtpPort",
        "smtpUsername": "smtpUsername",
        "smtpPassword": "smtpPassword",
        "smtpFrom": "smtpFrom"
      },
      "onSuccess": {
        "behavior": "reload"
      }
    },
    "mailTestSend": {
      "type": "request",
      "method": "POST",
      "url": "/api/mail/test-send",
      "bodyMapping": {
        "to": "to"
      },
      "onSuccess": {
        "behavior": "reload"
      }
    }
  },
  "body": {
    "type": "section",
    "id": "settings",
    "permissionCascade": {
      "keys": [
        "edit"
      ]
    },
    "permissions": {
      "edit": "$context.user.permissions contains \"settings.write\""
    },
    "children": [
      {
        "type": "text",
        "props": {
          "text": "Site defaults used across the admin shell, login page, and public startup configuration. Brand icons are uploaded (auto-resized and compressed; SVG not supported); leave empty to hide.",
          "textKey": "schema.settings.description"
        }
      },
      {
        "type": "tabs",
        "id": "settings-tabs",
        "children": [
          {
            "type": "section",
            "id": "tab-general",
            "props": {
              "labelKey": "schema.settings.tab.general",
              "label": "General"
            },
            "children": [
              {
                "type": "form",
                "id": "settings-general",
                "props": {
                  "titleKey": "schema.settings.toolbar.general",
                  "fields": [
                    {
                      "id": "siteTitle",
                      "label": "Site title",
                      "labelKey": "schema.settings.field.siteTitle",
                      "type": "input"
                    },
                    {
                      "id": "copyrightText",
                      "label": "Footer copyright text",
                      "labelKey": "schema.settings.field.copyrightText",
                      "type": "input"
                    },
                    {
                      "id": "icpNumber",
                      "label": "ICP number",
                      "labelKey": "schema.settings.field.icpNumber",
                      "type": "input"
                    }
                  ],
                  "recordSource": {
                    "method": "GET",
                    "url": "/api/settings/default",
                    "responseMapping": {
                      "siteTitle": "siteTitle",
                      "copyrightText": "copyrightText",
                      "icpNumber": "icpNumber"
                    }
                  },
                  "submitAction": "updateGeneral",
                  "submitLabelKey": "schema.settings.submit.save"
                }
              }
            ]
          },
          {
            "type": "section",
            "id": "tab-branding",
            "props": {
              "labelKey": "schema.settings.tab.branding",
              "label": "Branding"
            },
            "children": [
              {
                "type": "form",
                "id": "settings-branding",
                "props": {
                  "titleKey": "schema.settings.toolbar.branding",
                  "fields": [
                    {
                      "id": "logoUrl",
                      "label": "Logo (empty = hide)",
                      "labelKey": "schema.settings.field.logoUrl",
                      "type": "upload",
                      "actionRef": "uploadBrandingLogo"
                    },
                    {
                      "id": "logoUrlLight",
                      "label": "Logo (light theme)",
                      "labelKey": "schema.settings.field.logoUrlLight",
                      "type": "upload",
                      "actionRef": "uploadBrandingLogo"
                    },
                    {
                      "id": "logoUrlDark",
                      "label": "Logo (dark theme)",
                      "labelKey": "schema.settings.field.logoUrlDark",
                      "type": "upload",
                      "actionRef": "uploadBrandingLogo"
                    },
                    {
                      "id": "faviconUrl",
                      "label": "Favicon",
                      "labelKey": "schema.settings.field.faviconUrl",
                      "type": "upload",
                      "actionRef": "uploadBrandingFavicon"
                    }
                  ],
                  "recordSource": {
                    "method": "GET",
                    "url": "/api/settings/default",
                    "responseMapping": {
                      "logoUrl": "logoUrl",
                      "logoUrlLight": "logoUrlLight",
                      "logoUrlDark": "logoUrlDark",
                      "faviconUrl": "faviconUrl"
                    }
                  },
                  "submitAction": "updateBranding",
                  "submitLabelKey": "schema.settings.submit.save"
                }
              }
            ]
          },
          {
            "type": "section",
            "id": "tab-localization",
            "props": {
              "labelKey": "schema.settings.tab.localization",
              "label": "Localization"
            },
            "children": [
              {
                "type": "form",
                "id": "settings-localization",
                "props": {
                  "titleKey": "schema.settings.toolbar.localization",
                  "fields": [
                    {
                      "id": "defaultLocale",
                      "label": "Default language",
                      "labelKey": "schema.settings.field.defaultLocale",
                      "type": "select",
                      "options": [
                        {
                          "value": "auto",
                          "label": "Auto (follow browser)",
                          "labelKey": "schema.settings.option.localeAuto"
                        },
                        {
                          "value": "zh-CN",
                          "label": "简体中文",
                          "labelKey": "locale.name.zh-CN"
                        },
                        {
                          "value": "en-US",
                          "label": "English",
                          "labelKey": "locale.name.en-US"
                        }
                      ]
                    },
                    {
                      "id": "siteTimezone",
                      "label": "Default timezone (IANA name or auto)",
                      "labelKey": "schema.settings.field.siteTimezone",
                      "type": "input"
                    }
                  ],
                  "recordSource": {
                    "method": "GET",
                    "url": "/api/settings/default",
                    "responseMapping": {
                      "defaultLocale": "defaultLocale",
                      "siteTimezone": "siteTimezone"
                    }
                  },
                  "submitAction": "updateLocalization",
                  "submitLabelKey": "schema.settings.submit.save"
                }
              }
            ]
          },
          {
            "type": "section",
            "id": "tab-appearance",
            "props": {
              "labelKey": "schema.settings.tab.appearance",
              "label": "Appearance"
            },
            "children": [
              {
                "type": "form",
                "id": "settings-appearance",
                "props": {
                  "titleKey": "schema.settings.toolbar.appearance",
                  "fields": [
                    {
                      "id": "defaultTheme",
                      "label": "Default theme",
                      "labelKey": "schema.settings.field.defaultTheme",
                      "type": "select",
                      "options": [
                        {
                          "value": "auto",
                          "label": "Auto",
                          "labelKey": "schema.settings.option.themeAuto"
                        },
                        {
                          "value": "light",
                          "label": "Light",
                          "labelKey": "schema.settings.option.themeLight"
                        },
                        {
                          "value": "dark",
                          "label": "Dark",
                          "labelKey": "schema.settings.option.themeDark"
                        }
                      ]
                    }
                  ],
                  "recordSource": {
                    "method": "GET",
                    "url": "/api/settings/default",
                    "responseMapping": {
                      "defaultTheme": "defaultTheme"
                    }
                  },
                  "submitAction": "updateAppearance",
                  "submitLabelKey": "schema.settings.submit.save"
                }
              }
            ]
          },
          {
            "type": "section",
            "id": "tab-audit",
            "props": {
              "labelKey": "schema.settings.tab.audit",
              "label": "Audit log"
            },
            "children": [
              {
                "type": "form",
                "id": "settings-audit",
                "props": {
                  "titleKey": "schema.settings.toolbar.audit",
                  "fields": [
                    {
                      "id": "operationLogRetentionDays",
                      "label": "Retention days",
                      "labelKey": "schema.settings.field.operationLogRetentionDays",
                      "type": "inputNumber",
                      "min": 1,
                      "max": 3650,
                      "step": 1
                    },
                    {
                      "id": "operationLogExpirationAction",
                      "label": "When logs expire",
                      "labelKey": "schema.settings.field.operationLogExpirationAction",
                      "type": "select",
                      "options": [
                        {
                          "value": "archive",
                          "label": "Archive",
                          "labelKey": "schema.settings.option.expirationArchive"
                        },
                        {
                          "value": "delete",
                          "label": "Delete",
                          "labelKey": "schema.settings.option.expirationDelete"
                        }
                      ]
                    }
                  ],
                  "recordSource": {
                    "method": "GET",
                    "url": "/api/settings/default",
                    "responseMapping": {
                      "operationLogRetentionDays": "operationLogRetentionDays",
                      "operationLogExpirationAction": "operationLogExpirationAction"
                    }
                  },
                  "submitAction": "updateAudit",
                  "submitLabelKey": "schema.settings.submit.save"
                }
              }
            ]
          },
          {
            "type": "section",
            "id": "tab-security",
            "props": {
              "labelKey": "schema.settings.tab.security",
              "label": "Security"
            },
            "children": [
              {
                "type": "form",
                "id": "settings-security",
                "props": {
                  "titleKey": "schema.settings.toolbar.security",
                  "fields": [
                    {
                      "id": "enabled",
                      "label": "Require captcha on login",
                      "labelKey": "schema.settings.field.requireCaptcha",
                      "type": "select",
                      "options": [
                        {
                          "value": "true",
                          "label": "Enabled",
                          "labelKey": "schema.settings.option.captchaEnabled"
                        },
                        {
                          "value": "false",
                          "label": "Disabled",
                          "labelKey": "schema.settings.option.captchaDisabled"
                        }
                      ]
                    }
                  ],
                  "recordSource": {
                    "method": "GET",
                    "url": "/api/captcha/settings",
                    "responseMapping": {
                      "enabled": "enabled"
                    }
                  },
                  "submitAction": "updateCaptcha",
                  "submitLabelKey": "schema.settings.submit.save"
                }
              }
            ]
          },
          {
            "type": "section",
            "id": "tab-mail",
            "props": {
              "labelKey": "schema.settings.tab.mail",
              "label": "Mail"
            },
            "children": [
              {
                "type": "form",
                "id": "settings-mail",
                "props": {
                  "titleKey": "schema.settings.toolbar.mail",
                  "fields": [
                    {
                      "id": "channel",
                      "label": "Outbound channel",
                      "labelKey": "schema.settings.field.channel",
                      "type": "select",
                      "options": [
                        {
                          "value": "mock",
                          "label": "Mock (in-app records)",
                          "labelKey": "schema.settings.option.channelMock"
                        },
                        {
                          "value": "resend",
                          "label": "Resend (production)",
                          "labelKey": "schema.settings.option.channelResend"
                        },
                        {
                          "value": "smtp",
                          "label": "SMTP",
                          "labelKey": "schema.settings.option.channelSMTP"
                        }
                      ]
                    },
                    {
                      "id": "mockRetention",
                      "label": "Mock record retention (rows)",
                      "labelKey": "schema.settings.field.mockRetention",
                      "type": "inputNumber",
                      "min": 1,
                      "max": 100000,
                      "step": 1
                    },
                    {
                      "id": "resendApiKey",
                      "label": "Resend API key (empty = keep current)",
                      "labelKey": "schema.settings.field.resendApiKey",
                      "type": "input"
                    },
                    {
                      "id": "resendFrom",
                      "label": "Resend sender address",
                      "labelKey": "schema.settings.field.resendFrom",
                      "type": "input"
                    },
                    {
                      "id": "smtpHost",
                      "label": "SMTP host",
                      "labelKey": "schema.settings.field.smtpHost",
                      "type": "input"
                    },
                    {
                      "id": "smtpPort",
                      "label": "SMTP port (empty = 465)",
                      "labelKey": "schema.settings.field.smtpPort",
                      "type": "inputNumber",
                      "min": 1,
                      "max": 65535,
                      "step": 1
                    },
                    {
                      "id": "smtpUsername",
                      "label": "SMTP username",
                      "labelKey": "schema.settings.field.smtpUsername",
                      "type": "input"
                    },
                    {
                      "id": "smtpPassword",
                      "label": "SMTP password (empty = keep current)",
                      "labelKey": "schema.settings.field.smtpPassword",
                      "type": "input"
                    },
                    {
                      "id": "smtpFrom",
                      "label": "SMTP sender address",
                      "labelKey": "schema.settings.field.smtpFrom",
                      "type": "input"
                    }
                  ],
                  "recordSource": {
                    "method": "GET",
                    "url": "/api/mail/config",
                    "responseMapping": {
                      "channel": "channel",
                      "mockRetention": "mockRetention",
                      "resendFrom": "resend.from",
                      "smtpHost": "smtp.host",
                      "smtpPort": "smtp.port",
                      "smtpUsername": "smtp.username",
                      "smtpFrom": "smtp.from"
                    }
                  },
                  "submitAction": "updateMail",
                  "submitLabelKey": "schema.settings.submit.save"
                }
              },
              {
                "type": "form",
                "id": "mail-test-send",
                "props": {
                  "titleKey": "schema.mail.test.title",
                  "fields": [
                    {
                      "id": "to",
                      "label": "Recipient",
                      "labelKey": "schema.mail.test.to",
                      "type": "input"
                    }
                  ],
                  "submitAction": "mailTestSend",
                  "submitLabelKey": "schema.mail.test.submit"
                }
              },
              {
                "type": "table",
                "id": "mail-outbox-table",
                "props": {
                  "titleKey": "schema.mail.outbox.title",
                  "columns": [
                    {
                      "field": "to",
                      "label": "To",
                      "labelKey": "schema.mail.column.to"
                    },
                    {
                      "field": "subject",
                      "label": "Subject",
                      "labelKey": "schema.mail.column.subject"
                    },
                    {
                      "field": "created_at",
                      "label": "Created",
                      "labelKey": "schema.mail.column.created"
                    }
                  ],
                  "dataSource": "/api/mail/outbox"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "actionButton",
        "id": "settings-reset",
        "props": {
          "label": "Restore defaults",
          "labelKey": "schema.settings.toolbar.reset",
          "actionId": "resetSettings",
          "permissionIntent": "edit",
          "key": "reset",
          "confirm": "Restore all settings to their defaults?",
          "confirmKey": "schema.settings.confirm.reset"
        }
      }
    ]
  }
}
