{
  "meta": {
    "pageId": "settings",
    "title": "Settings",
    "protocolVersion": "2.7",
    "requiredCapabilities": [
      "app.manifest",
      "app.navigation",
      "permissions.inheritance",
      "actions.row.request",
      "actions.page.trigger",
      "table.sort",
      "form.controls.extended"
    ]
  },
  "actions": {
    "updateSettings": {
      "type": "request",
      "method": "PATCH",
      "url": "/api/settings/{id}",
      "bodyMapping": {
        "siteTitle": "siteTitle",
        "logoUrl": "logoUrl"
      },
      "onSuccess": {
        "behavior": "reload"
      }
    },
    "openEdit": {
      "type": "modal",
      "content": {
        "type": "form",
        "id": "edit-settings-form",
        "permissionCascade": {
          "keys": [
            "edit"
          ]
        },
        "permissions": {
          "edit": "$context.user.permissions contains \"settings.write\""
        },
        "props": {
          "fields": [
            {
              "id": "siteTitle",
              "label": "Site title",
              "type": "input",
              "labelKey": "schema.settings.field.siteTitle"
            },
            {
              "id": "logoUrl",
              "label": "Logo URL (empty = hide logo)",
              "type": "textarea",
              "labelKey": "schema.settings.field.logoUrl"
            }
          ],
          "submitAction": "updateSettings",
          "submitLabel": "Save settings",
          "submitLabelKey": "schema.settings.submit.save"
        }
      }
    }
  },
  "body": {
    "type": "section",
    "id": "settings",
    "children": [
      {
        "type": "text",
        "props": {
          "text": "Site branding used in the admin shell, login page, and browser tab title. Logo is a URL (upload not available); leave empty to hide the logo.",
          "textKey": "schema.settings.description"
        }
      },
      {
        "type": "table",
        "id": "settings-table",
        "permissionCascade": {
          "keys": [
            "edit"
          ]
        },
        "permissions": {
          "edit": "$context.user.permissions contains \"settings.write\""
        },
        "props": {
          "columns": [
            {
              "field": "siteTitle",
              "label": "Site title",
              "labelKey": "schema.settings.column.siteTitle"
            },
            {
              "field": "logoUrl",
              "label": "Logo URL",
              "labelKey": "schema.settings.column.logoUrl"
            },
            {
              "field": "updatedAt",
              "label": "Updated",
              "sortable": true,
              "labelKey": "schema.settings.column.updated"
            }
          ],
          "dataSource": "/api/settings",
          "actions": [
            {
              "key": "edit",
              "label": "Edit",
              "actionRef": "openEdit",
              "permissionIntent": "edit",
              "labelKey": "schema.settings.action.edit"
            }
          ]
        }
      },
      {
        "type": "recordView",
        "id": "settings-detail",
        "props": {}
      }
    ]
  }
}
