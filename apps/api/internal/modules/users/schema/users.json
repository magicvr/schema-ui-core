{
  "meta": {
    "pageId": "users",
    "title": "Users",
    "protocolVersion": "2.7",
    "requiredCapabilities": [
      "app.manifest",
      "app.navigation",
      "permissions.inheritance",
      "actions.row.request",
      "actions.page.trigger",
      "table.sort",
      "form.controls.extended",
      "form.controls.advanced"
    ]
  },
  "actions": {
    "createUser": {
      "type": "request",
      "method": "POST",
      "url": "/api/users",
      "bodyMapping": {
        "username": "username",
        "name": "name",
        "password": "password"
      },
      "onSuccess": {
        "behavior": "reload"
      }
    },
    "updateUser": {
      "type": "request",
      "method": "PATCH",
      "url": "/api/users/{id}",
      "bodyMapping": {
        "name": "name"
      },
      "onSuccess": {
        "behavior": "reload"
      }
    },
    "updateUserRoles": {
      "type": "request",
      "method": "PATCH",
      "url": "/api/users/{id}",
      "bodyMapping": {
        "roles": "roles"
      },
      "onSuccess": {
        "behavior": "reload"
      }
    },
    "changeUserPassword": {
      "type": "request",
      "method": "PATCH",
      "url": "/api/users/{id}",
      "bodyMapping": {
        "password": "password"
      },
      "onSuccess": {
        "behavior": "reload"
      }
    },
    "deleteUser": {
      "type": "request",
      "method": "DELETE",
      "url": "/api/users/{id}",
      "onSuccess": {
        "behavior": "reload"
      }
    },
    "enableUser": {
      "type": "request",
      "method": "POST",
      "url": "/api/users/{id}/enable",
      "onSuccess": {
        "behavior": "reload"
      }
    },
    "disableUser": {
      "type": "request",
      "method": "POST",
      "url": "/api/users/{id}/disable",
      "onSuccess": {
        "behavior": "reload"
      }
    },
    "unlockUser": {
      "type": "request",
      "method": "POST",
      "url": "/api/users/{id}/unlock",
      "onSuccess": {
        "behavior": "reload"
      }
    },
    "openCreate": {
      "type": "modal",
      "content": {
        "type": "form",
        "id": "create-user-form",
        "permissionCascade": {
          "keys": [
            "edit"
          ]
        },
        "permissions": {
          "edit": "$context.user.permissions contains \"users.write\""
        },
        "props": {
          "fields": [
            {
              "id": "username",
              "label": "Username",
              "type": "input",
              "labelKey": "schema.users.field.username"
            },
            {
              "id": "name",
              "label": "Name",
              "type": "input",
              "labelKey": "schema.users.field.name"
            },
            {
              "id": "password",
              "label": "Password",
              "type": "password",
              "labelKey": "schema.users.field.password"
            }
          ],
          "submitAction": "createUser",
          "submitLabel": "Create user",
          "submitLabelKey": "schema.users.submit.create"
        }
      }
    },
    "openEdit": {
      "type": "modal",
      "content": {
        "type": "form",
        "id": "edit-user-form",
        "permissionCascade": {
          "keys": [
            "edit"
          ]
        },
        "permissions": {
          "edit": "$context.user.permissions contains \"users.write\""
        },
        "props": {
          "fields": [
            {
              "id": "name",
              "label": "Name",
              "type": "input",
              "labelKey": "schema.users.field.name"
            }
          ],
          "submitAction": "updateUser",
          "submitLabel": "Save changes",
          "submitLabelKey": "schema.users.submit.save"
        }
      }
    },
    "openRoles": {
      "type": "modal",
      "content": {
        "type": "form",
        "id": "edit-user-roles-form",
        "permissionCascade": {
          "keys": [
            "edit"
          ]
        },
        "permissions": {
          "edit": "$context.user.permissions contains \"roles.assign\""
        },
        "props": {
          "fields": [
            {
              "id": "roles",
              "label": "Role keys (comma-separated; system: admin, editor, viewer; custom keys allowed)",
              "type": "textarea",
              "labelKey": "schema.users.field.roles"
            }
          ],
          "submitAction": "updateUserRoles",
          "submitLabel": "Save roles",
          "submitLabelKey": "schema.users.submit.saveRoles"
        }
      }
    },
    "openPassword": {
      "type": "modal",
      "content": {
        "type": "form",
        "id": "change-user-password-form",
        "permissionCascade": {
          "keys": [
            "edit"
          ]
        },
        "permissions": {
          "edit": "$context.user.permissions contains \"users.write\""
        },
        "props": {
          "fields": [
            {
              "id": "password",
              "label": "New password",
              "type": "password",
              "labelKey": "schema.users.field.newPassword"
            }
          ],
          "submitAction": "changeUserPassword",
          "submitLabel": "Change password",
          "submitLabelKey": "schema.users.submit.changePassword"
        }
      }
    }
  },
  "body": {
    "type": "section",
    "id": "users",
    "children": [
      {
        "type": "table",
        "id": "users-table",
        "permissionCascade": {
          "keys": [
            "edit",
            "delete"
          ]
        },
        "permissions": {
          "edit": "$context.user.permissions contains \"users.write\"",
          "delete": "$context.user.permissions contains \"users.write\""
        },
        "props": {
          "columns": [
            {
              "field": "id",
              "label": "ID",
              "labelKey": "schema.users.column.id"
            },
            {
              "field": "username",
              "label": "Username",
              "sortable": true,
              "labelKey": "schema.users.column.username"
            },
            {
              "field": "name",
              "label": "Name",
              "sortable": true,
              "labelKey": "schema.users.column.name"
            },
            {
              "field": "roles",
              "label": "Roles",
              "labelKey": "schema.users.column.roles"
            },
            {
              "field": "enabled",
              "label": "Enabled",
              "labelKey": "schema.users.column.enabled"
            },
            {
              "field": "updatedAt",
              "label": "Updated",
              "sortable": true,
              "labelKey": "schema.users.column.updated"
            }
          ],
          "dataSource": "/api/users",
          "toolbar": [
            {
              "key": "create",
              "label": "New user",
              "actionRef": "openCreate",
              "permissionIntent": "edit",
              "labelKey": "schema.users.toolbar.newUser"
            }
          ],
          "actions": [
            {
              "key": "edit",
              "label": "Edit",
              "actionRef": "openEdit",
              "permissionIntent": "edit",
              "labelKey": "schema.users.action.edit"
            },
            {
              "key": "roles",
              "label": "Roles",
              "actionRef": "openRoles",
              "permissions": {
                "edit": "$context.user.permissions contains \"roles.assign\""
              },
              "labelKey": "schema.users.action.roles"
            },
            {
              "key": "password",
              "label": "Password",
              "actionRef": "openPassword",
              "permissionIntent": "edit",
              "labelKey": "schema.users.action.password"
            },
            {
              "key": "enable",
              "label": "Enable",
              "actionRef": "enableUser",
              "permissions": {
                "edit": "$context.user.permissions contains \"users.enable\""
              },
              "requestMapping": {
                "path": {
                  "id": "$row.id"
                }
              },
              "disabledWhen": {
                "field": "enabled",
                "equals": true
              },
              "confirm": "Enable this user?",
              "labelKey": "schema.users.action.enable",
              "confirmKey": "schema.users.confirm.enable"
            },
            {
              "key": "disable",
              "label": "Disable",
              "actionRef": "disableUser",
              "permissions": {
                "edit": "$context.user.permissions contains \"users.disable\""
              },
              "requestMapping": {
                "path": {
                  "id": "$row.id"
                }
              },
              "disabledWhen": {
                "field": "enabled",
                "equals": false
              },
              "confirm": "Disable this user? All sessions will be revoked.",
              "labelKey": "schema.users.action.disable",
              "confirmKey": "schema.users.confirm.disable"
            },
            {
              "key": "unlock",
              "label": "Unlock",
              "actionRef": "unlockUser",
              "permissions": {
                "edit": "$context.user.permissions contains \"users.enable\""
              },
              "requestMapping": {
                "path": {
                  "id": "$row.id"
                }
              },
              "disabledWhen": {
                "field": "locked",
                "equals": false
              },
              "confirm": "Unlock this user?",
              "labelKey": "schema.users.action.unlock",
              "confirmKey": "schema.users.confirm.unlock"
            },
            {
              "key": "delete",
              "label": "Delete",
              "actionRef": "deleteUser",
              "permissionIntent": "delete",
              "requestMapping": {
                "path": {
                  "id": "$row.id"
                }
              },
              "confirm": "Delete this user?",
              "labelKey": "schema.users.action.delete",
              "confirmKey": "schema.users.confirm.delete"
            }
          ]
        }
      },
      {
        "type": "recordView",
        "id": "user-detail",
        "props": {
          "title": "User details",
          "titleKey": "schema.users.detail.title",
          "fields": [
            { "key": "id", "label": "ID", "labelKey": "schema.users.column.id" },
            { "key": "username", "label": "Username", "labelKey": "schema.users.column.username" },
            { "key": "name", "label": "Name", "labelKey": "schema.users.column.name" },
            { "key": "roles", "label": "Roles", "labelKey": "schema.users.column.roles" },
            { "key": "createdAt", "label": "Created", "labelKey": "schema.users.column.created" },
            { "key": "updatedAt", "label": "Updated", "labelKey": "schema.users.column.updated" }
          ]
        }
      }
    ]
  }
}