{
  "meta": {
    "pageId": "roles",
    "title": "Roles",
    "protocolVersion": "2.7",
    "requiredCapabilities": [
      "app.manifest",
      "app.navigation",
      "permissions.inheritance",
      "actions.row.request",
      "actions.page.trigger",
      "table.sort",
      "form.controls.advanced"
    ]
  },
  "actions": {
    "createRole": {
      "type": "request",
      "method": "POST",
      "url": "/api/roles",
      "bodyMapping": {
        "key": "key",
        "name": "name",
        "permissions": "permissions",
        "menuItems": "menuItems"
      },
      "onSuccess": {
        "behavior": "reload"
      }
    },
    "updateRole": {
      "type": "request",
      "method": "PATCH",
      "url": "/api/roles/{id}",
      "bodyMapping": {
        "name": "name",
        "permissions": "permissions",
        "menuItems": "menuItems"
      },
      "onSuccess": {
        "behavior": "reload"
      }
    },
    "deleteRole": {
      "type": "request",
      "method": "DELETE",
      "url": "/api/roles/{id}",
      "onSuccess": {
        "behavior": "reload"
      }
    },
    "openCreate": {
      "type": "modal",
      "content": {
        "type": "form",
        "id": "create-role-form",
        "permissionCascade": {
          "keys": [
            "edit"
          ]
        },
        "permissions": {
          "edit": "$context.user.roles contains \"admin\""
        },
        "props": {
          "fields": [
            {
              "id": "key",
              "label": "Key",
              "type": "input",
              "labelKey": "schema.roles.field.key"
            },
            {
              "id": "name",
              "label": "Name",
              "type": "input",
              "labelKey": "schema.roles.field.name"
            },
            {
              "id": "permissions",
              "label": "Permissions",
              "type": "checkboxGroup",
              "options": [
                {
                  "value": "users.read",
                  "label": "Read users",
                  "labelKey": "schema.roles.option.readUsers"
                },
                {
                  "value": "users.write",
                  "label": "Write users",
                  "labelKey": "schema.roles.option.writeUsers"
                },
                {
                  "value": "roles.read",
                  "label": "Read roles",
                  "labelKey": "schema.roles.option.readRoles"
                },
                {
                  "value": "roles.write",
                  "label": "Write roles",
                  "labelKey": "schema.roles.option.writeRoles"
                },
                {
                  "value": "roles.assign",
                  "label": "Assign roles",
                  "labelKey": "schema.roles.option.assignRoles"
                },
                {
                  "value": "settings.read",
                  "label": "Read settings",
                  "labelKey": "schema.roles.option.readSettings"
                },
                {
                  "value": "settings.write",
                  "label": "Write settings",
                  "labelKey": "schema.roles.option.writeSettings"
                },
                {
                  "value": "operations.read",
                  "label": "Read activity log",
                  "labelKey": "schema.roles.option.readActivityLog"
                }
              ],
              "labelKey": "schema.roles.field.permissions"
            },
            {
              "id": "menuItems",
              "label": "Menu access",
              "type": "checkboxGroup",
              "options": [
                {
                  "value": "menu-users",
                  "label": "Users",
                  "labelKey": "schema.roles.option.users"
                },
                {
                  "value": "menu-roles",
                  "label": "Roles",
                  "labelKey": "schema.roles.option.roles"
                },
                {
                  "value": "menu-settings",
                  "label": "Settings",
                  "labelKey": "schema.roles.option.settings"
                },
                {
                  "value": "menu-activity",
                  "label": "Activity",
                  "labelKey": "schema.roles.option.activity"
                }
              ],
              "labelKey": "schema.roles.field.menuAccess"
            }
          ],
          "submitAction": "createRole",
          "submitLabel": "Create role",
          "submitLabelKey": "schema.roles.submit.create"
        }
      }
    },
    "openEdit": {
      "type": "modal",
      "content": {
        "type": "form",
        "id": "edit-role-form",
        "permissionCascade": {
          "keys": [
            "edit"
          ]
        },
        "permissions": {
          "edit": "$context.user.roles contains \"admin\""
        },
        "props": {
          "fields": [
            {
              "id": "name",
              "label": "Name",
              "type": "input",
              "labelKey": "schema.roles.field.name"
            },
            {
              "id": "permissions",
              "label": "Permissions",
              "type": "checkboxGroup",
              "options": [
                {
                  "value": "users.read",
                  "label": "Read users",
                  "labelKey": "schema.roles.option.readUsers"
                },
                {
                  "value": "users.write",
                  "label": "Write users",
                  "labelKey": "schema.roles.option.writeUsers"
                },
                {
                  "value": "roles.read",
                  "label": "Read roles",
                  "labelKey": "schema.roles.option.readRoles"
                },
                {
                  "value": "roles.write",
                  "label": "Write roles",
                  "labelKey": "schema.roles.option.writeRoles"
                },
                {
                  "value": "roles.assign",
                  "label": "Assign roles",
                  "labelKey": "schema.roles.option.assignRoles"
                },
                {
                  "value": "settings.read",
                  "label": "Read settings",
                  "labelKey": "schema.roles.option.readSettings"
                },
                {
                  "value": "settings.write",
                  "label": "Write settings",
                  "labelKey": "schema.roles.option.writeSettings"
                },
                {
                  "value": "operations.read",
                  "label": "Read activity log",
                  "labelKey": "schema.roles.option.readActivityLog"
                }
              ],
              "labelKey": "schema.roles.field.permissions"
            },
            {
              "id": "menuItems",
              "label": "Menu access",
              "type": "checkboxGroup",
              "options": [
                {
                  "value": "menu-users",
                  "label": "Users",
                  "labelKey": "schema.roles.option.users"
                },
                {
                  "value": "menu-roles",
                  "label": "Roles",
                  "labelKey": "schema.roles.option.roles"
                },
                {
                  "value": "menu-settings",
                  "label": "Settings",
                  "labelKey": "schema.roles.option.settings"
                },
                {
                  "value": "menu-activity",
                  "label": "Activity",
                  "labelKey": "schema.roles.option.activity"
                }
              ],
              "labelKey": "schema.roles.field.menuAccess"
            }
          ],
          "submitAction": "updateRole",
          "submitLabel": "Save changes",
          "submitLabelKey": "schema.roles.submit.save"
        }
      }
    }
  },
  "body": {
    "type": "section",
    "id": "roles",
    "children": [
      {
        "type": "table",
        "id": "roles-table",
        "permissionCascade": {
          "keys": [
            "edit",
            "delete"
          ]
        },
        "permissions": {
          "edit": "$context.user.roles contains \"admin\"",
          "delete": "$context.user.permissions contains \"roles.write\""
        },
        "props": {
          "columns": [
            {
              "field": "id",
              "label": "ID",
              "labelKey": "schema.roles.column.id"
            },
            {
              "field": "key",
              "label": "Key",
              "sortable": true,
              "labelKey": "schema.roles.column.key"
            },
            {
              "field": "name",
              "label": "Name",
              "sortable": true,
              "labelKey": "schema.roles.column.name"
            },
            {
              "field": "permissions",
              "label": "Permissions",
              "labelKey": "schema.roles.column.permissions",
              "truncate": true
            },
            {
              "field": "menuItems",
              "label": "Menus",
              "labelKey": "schema.roles.column.menus",
              "truncate": true
            },
            {
              "field": "assignedUsers",
              "label": "Users",
              "labelKey": "schema.roles.column.users"
            },
            {
              "field": "system",
              "label": "System",
              "labelKey": "schema.roles.column.system"
            },
            {
              "field": "updatedAt",
              "label": "Updated",
              "sortable": true,
              "labelKey": "schema.roles.column.updated"
            }
          ],
          "dataSource": "/api/roles",
          "toolbar": [
            {
              "key": "create",
              "label": "New role",
              "actionRef": "openCreate",
              "permissionIntent": "edit",
              "labelKey": "schema.roles.toolbar.newRole"
            }
          ],
          "actions": [
            {
              "key": "edit",
              "label": "Edit",
              "actionRef": "openEdit",
              "permissionIntent": "edit",
              "disabledWhen": {
                "field": "editable",
                "equals": false
              },
              "labelKey": "schema.roles.action.edit"
            },
            {
              "key": "delete",
              "label": "Delete",
              "actionRef": "deleteRole",
              "permissionIntent": "delete",
              "disabledWhen": {
                "field": "deletable",
                "equals": false
              },
              "requestMapping": {
                "path": {
                  "id": "$row.id"
                }
              },
              "confirm": "Delete this role?",
              "labelKey": "schema.roles.action.delete",
              "confirmKey": "schema.roles.confirm.delete"
            }
          ]
        }
      },
      {
        "type": "recordView",
        "id": "role-detail",
        "props": {
          "title": "Role details",
          "titleKey": "schema.roles.detail.title",
          "fields": [
            { "key": "id", "label": "ID", "labelKey": "schema.roles.column.id" },
            { "key": "key", "label": "Key", "labelKey": "schema.roles.column.key" },
            { "key": "name", "label": "Name", "labelKey": "schema.roles.column.name" },
            { "key": "permissions", "label": "Permissions", "labelKey": "schema.roles.column.permissions" },
            { "key": "menuItems", "label": "Menus", "labelKey": "schema.roles.column.menus" },
            { "key": "assignedUsers", "label": "Users", "labelKey": "schema.roles.column.users" },
            { "key": "system", "label": "System", "labelKey": "schema.roles.column.system" },
            { "key": "createdAt", "label": "Created", "labelKey": "schema.roles.column.created" },
            { "key": "updatedAt", "label": "Updated", "labelKey": "schema.roles.column.updated" }
          ]
        }
      }
    ]
  }
}
