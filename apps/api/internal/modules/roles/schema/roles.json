{
  "meta": {
    "pageId": "roles",
    "title": "Roles",
    "protocolVersion": "2.7",
    "requiredCapabilities": [
      "app.manifest",
      "app.navigation",
      "permissions.inheritance",
      "actions.row.request",
      "actions.page.trigger",
      "table.sort",
      "form.controls.advanced"
    ]
  },
  "actions": {
    "createRole": {
      "type": "request",
      "method": "POST",
      "url": "/api/roles",
      "bodyMapping": { "key": "key", "name": "name", "permissions": "permissions", "menuItems": "menuItems" },
      "onSuccess": { "behavior": "reload" }
    },
    "updateRole": {
      "type": "request",
      "method": "PATCH",
      "url": "/api/roles/{id}",
      "bodyMapping": { "name": "name", "permissions": "permissions", "menuItems": "menuItems" },
      "onSuccess": { "behavior": "reload" }
    },
    "deleteRole": {
      "type": "request",
      "method": "DELETE",
      "url": "/api/roles/{id}",
      "onSuccess": { "behavior": "reload" }
    },
    "openCreate": {
      "type": "modal",
      "content": {
        "type": "form",
        "id": "create-role-form",
        "permissionCascade": { "keys": ["edit"] },
        "permissions": { "edit": "$context.user.roles contains \"admin\"" },
        "props": {
          "fields": [
            { "id": "key", "label": "Key", "type": "input" },
            { "id": "name", "label": "Name", "type": "input" },
            {
              "id": "permissions",
              "label": "Permissions",
              "type": "checkboxGroup",
              "options": [
                { "value": "users.read", "label": "Read users" },
                { "value": "users.write", "label": "Write users" },
                { "value": "roles.read", "label": "Read roles" },
                { "value": "roles.write", "label": "Write roles" },
                { "value": "roles.assign", "label": "Assign roles" },
                { "value": "settings.read", "label": "Read settings" },
                { "value": "settings.write", "label": "Write settings" },
                { "value": "operations.read", "label": "Read activity log" }
              ]
            },
            {
              "id": "menuItems",
              "label": "Menu access",
              "type": "checkboxGroup",
              "options": [
                { "value": "menu-users", "label": "Users" },
                { "value": "menu-roles", "label": "Roles" },
                { "value": "menu-settings", "label": "Settings" },
                { "value": "menu-activity", "label": "Activity" }
              ]
            }
          ],
          "submitAction": "createRole",
          "submitLabel": "Create role"
        }
      }
    },
    "openEdit": {
      "type": "modal",
      "content": {
        "type": "form",
        "id": "edit-role-form",
        "permissionCascade": { "keys": ["edit"] },
        "permissions": { "edit": "$context.user.roles contains \"admin\"" },
        "props": {
          "fields": [
            { "id": "name", "label": "Name", "type": "input" },
            {
              "id": "permissions",
              "label": "Permissions",
              "type": "checkboxGroup",
              "options": [
                { "value": "users.read", "label": "Read users" },
                { "value": "users.write", "label": "Write users" },
                { "value": "roles.read", "label": "Read roles" },
                { "value": "roles.write", "label": "Write roles" },
                { "value": "roles.assign", "label": "Assign roles" },
                { "value": "settings.read", "label": "Read settings" },
                { "value": "settings.write", "label": "Write settings" },
                { "value": "operations.read", "label": "Read activity log" }
              ]
            },
            {
              "id": "menuItems",
              "label": "Menu access",
              "type": "checkboxGroup",
              "options": [
                { "value": "menu-users", "label": "Users" },
                { "value": "menu-roles", "label": "Roles" },
                { "value": "menu-settings", "label": "Settings" },
                { "value": "menu-activity", "label": "Activity" }
              ]
            }
          ],
          "submitAction": "updateRole",
          "submitLabel": "Save changes"
        }
      }
    }
  },
  "body": {
    "type": "section",
    "id": "roles",
    "children": [
      {
        "type": "table",
        "id": "roles-table",
        "permissionCascade": { "keys": ["edit", "delete"] },
        "permissions": {
          "edit": "$context.user.roles contains \"admin\"",
          "delete": "$context.user.permissions contains \"roles.write\""
        },
        "props": {
          "columns": [
            { "field": "id", "label": "ID" },
            { "field": "key", "label": "Key", "sortable": true },
            { "field": "name", "label": "Name", "sortable": true },
            { "field": "permissions", "label": "Permissions" },
            { "field": "menuItems", "label": "Menus" },
            { "field": "assignedUsers", "label": "Users" },
            { "field": "system", "label": "System" },
            { "field": "updatedAt", "label": "Updated", "sortable": true }
          ],
          "dataSource": "/api/roles",
          "toolbar": [
            { "key": "create", "label": "New role", "actionRef": "openCreate", "permissionIntent": "edit" }
          ],
          "actions": [
            {
              "key": "edit",
              "label": "Edit",
              "actionRef": "openEdit",
              "permissionIntent": "edit",
              "disabledWhen": { "field": "editable", "equals": false }
            },
            {
              "key": "delete",
              "label": "Delete",
              "actionRef": "deleteRole",
              "permissionIntent": "delete",
              "disabledWhen": { "field": "deletable", "equals": false },
              "requestMapping": { "path": { "id": "$row.id" } },
              "confirm": "Delete this role?"
            }
          ]
        }
      },
      { "type": "recordView", "id": "role-detail", "props": {} }
    ]
  }
}
