{
  "meta": {
    "pageId": "activity",
    "title": "Activity",
    "protocolVersion": "2.7",
    "requiredCapabilities": [
      "app.manifest",
      "app.navigation",
      "permissions.inheritance",
      "actions.row.request",
      "table.sort",
      "form.controls.extended"
    ]
  },
  "actions": {
    "openDetail": {
      "type": "modal",
      "content": {
        "type": "form",
        "id": "operation-detail-form",
        "permissions": {
          "edit": "false"
        },
        "props": {
          "fields": [
            {
              "id": "id",
              "label": "ID",
              "type": "input",
              "labelKey": "schema.activity.field.id"
            },
            {
              "id": "event",
              "label": "Event",
              "type": "input",
              "labelKey": "schema.activity.field.event"
            },
            {
              "id": "actorName",
              "label": "Actor",
              "type": "input",
              "labelKey": "schema.activity.field.actorName"
            },
            {
              "id": "actorId",
              "label": "Actor ID",
              "type": "input",
              "labelKey": "schema.activity.field.actorId"
            },
            {
              "id": "recordId",
              "label": "Record ID",
              "type": "input",
              "labelKey": "schema.activity.field.recordId"
            },
            {
              "id": "detail",
              "label": "Detail",
              "type": "textarea",
              "labelKey": "schema.activity.field.detail"
            },
            {
              "id": "createdAt",
              "label": "Created",
              "type": "input",
              "labelKey": "schema.activity.field.createdAt"
            }
          ],
          "submitLabel": "Close",
          "submitLabelKey": "schema.activity.submit.close"
        }
      }
    }
  },
  "body": {
    "type": "section",
    "id": "activity",
    "children": [
      {
        "type": "text",
        "props": {
          "text": "Read-only operation log (auth and resource writes). Select a row for detail; no create/edit/delete.",
          "textKey": "schema.activity.text.intro"
        }
      },
      {
        "type": "form",
        "id": "ops-search",
        "props": {
          "mode": "search",
          "targetTable": "operations-table",
          "fields": [
            {
              "id": "q",
              "label": "Search",
              "type": "input",
              "labelKey": "schema.activity.field.search"
            }
          ],
          "submitLabel": "Search",
          "submitLabelKey": "schema.activity.submit.search"
        }
      },
      {
        "type": "table",
        "id": "operations-table",
        "permissions": {
          "edit": "$context.user.permissions contains \"operations.read\""
        },
        "props": {
          "columns": [
            {
              "field": "createdAt",
              "label": "When",
              "sortable": true,
              "labelKey": "schema.activity.column.when"
            },
            {
              "field": "event",
              "label": "Event",
              "sortable": true,
              "labelKey": "schema.activity.column.event"
            },
            {
              "field": "actorName",
              "label": "Actor",
              "sortable": true,
              "labelKey": "schema.activity.column.actor"
            },
            {
              "field": "recordId",
              "label": "Record",
              "labelKey": "schema.activity.column.record"
            },
            {
              "field": "detail",
              "label": "Detail",
              "labelKey": "schema.activity.column.detail"
            }
          ],
          "dataSource": "/api/operations",
          "actions": [
            {
              "key": "view",
              "label": "View",
              "actionRef": "openDetail",
              "permissionIntent": "edit",
              "labelKey": "schema.activity.action.view"
            }
          ]
        }
      },
      {
        "type": "recordView",
        "id": "operation-detail",
        "props": {}
      }
    ]
  }
}
