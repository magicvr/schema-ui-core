{
  "meta": {
    "pageId": "task-runs",
    "title": "Task runs",
    "protocolVersion": "2.7",
    "requiredCapabilities": [
      "app.manifest",
      "app.navigation",
      "permissions.inheritance",
      "table.sort"
    ]
  },
  "body": {
    "type": "section",
    "id": "task-runs",
    "children": [
      {
        "type": "form",
        "id": "task-runs-search",
        "props": {
          "mode": "search",
          "targetTable": "task-runs-table",
          "fields": [
            {
              "id": "q",
              "type": "input",
              "labelKey": "schema.taskRuns.search.q"
            },
            {
              "id": "status",
              "type": "select",
              "labelKey": "schema.taskRuns.filter.status",
              "options": [
                {
                  "value": "",
                  "labelKey": "schema.taskRuns.filter.status.all"
                },
                {
                  "value": "ran",
                  "labelKey": "schema.taskRuns.filter.status.ran"
                },
                {
                  "value": "failed",
                  "labelKey": "schema.taskRuns.filter.status.failed"
                }
              ]
            }
          ],
          "submitLabel": "Search",
          "submitLabelKey": "feedback.search"
        }
      },
      {
        "type": "table",
        "id": "task-runs-table",
        "props": {
          "columns": [
            {
              "field": "taskId",
              "label": "Task",
              "labelKey": "schema.taskRuns.column.task"
            },
            {
              "field": "status",
              "label": "Status",
              "labelKey": "schema.taskRuns.column.status"
            },
            {
              "field": "startedAt",
              "label": "Started",
              "sortable": true,
              "labelKey": "schema.taskRuns.column.started"
            },
            {
              "field": "finishedAt",
              "label": "Finished",
              "labelKey": "schema.taskRuns.column.finished"
            },
            {
              "field": "detail",
              "label": "Detail",
              "labelKey": "schema.taskRuns.column.detail"
            }
          ],
          "dataSource": "/api/task-runs"
        }
      }
    ]
  }
}
