{
  "meta": {
    "pageId": "form-controls",
    "title": "Form controls",
    "protocolVersion": "2.7",
    "requiredCapabilities": ["app.manifest", "app.navigation", "form.controls.extended", "form.controls.advanced"]
  },
  "body": {
    "type": "section",
    "props": { "title": "Form controls" },
    "children": [
      {
        "type": "text",
        "props": {
          "text": "Full registry form control surface (D-FORM): base controls incl. inputNumber / datePicker / dateRangePicker, 2.6 extended and 2.7 advanced controls."
        }
      },
      {
        "type": "form",
        "id": "controls-form",
        "props": {
          "fields": [
            { "id": "name", "label": "Name (input)", "type": "input" },
            {
              "id": "kind",
              "label": "Kind (select)",
              "type": "select",
              "options": [
                { "value": "standard", "label": "Standard" },
                { "value": "priority", "label": "Priority" }
              ]
            },
            { "id": "quantity", "label": "Quantity (inputNumber)", "type": "inputNumber", "min": 0, "max": 100, "step": 1, "defaultValue": 1 },
            { "id": "deliveryDate", "label": "Delivery date (datePicker)", "type": "datePicker" },
            { "id": "window", "label": "Window (dateRangePicker)", "type": "dateRangePicker", "startField": "windowStart", "endField": "windowEnd" },
            { "id": "approval", "label": "Approval (switch)", "type": "switch" },
            { "id": "auditNote", "label": "Audit note (textarea)", "type": "textarea" },
            {
              "id": "scope",
              "label": "Scope (radio)",
              "type": "radio",
              "options": [
                { "value": "internal", "label": "Internal" },
                { "value": "external", "label": "External" }
              ]
            },
            { "id": "tags", "label": "Tags (checkboxGroup)", "type": "checkboxGroup", "options": [{ "value": "alpha", "label": "Alpha" }, { "value": "beta", "label": "Beta" }] }
          ],
          "submitLabel": "Submit"
        }
      }
    ]
  }
}
