{
  "meta": {
    "pageId": "data-table",
    "title": "Data table",
    "protocolVersion": "2.7",
    "requiredCapabilities": ["app.manifest", "app.navigation", "table.sort"]
  },
  "body": {
    "type": "section",
    "props": { "title": "Data table" },
    "children": [
      {
        "type": "text",
        "props": {
          "text": "Sortable users from the Go list API (/api/users). This page exercises D-DATA list/detail and D-TABLE sort declarations."
        }
      },
      {
        "type": "table",
        "id": "users-table",
        "props": {
          "columns": [
            { "field": "id", "label": "ID" },
            { "field": "username", "label": "Username", "sortable": true },
            { "field": "name", "label": "Name", "sortable": true },
            { "field": "updatedAt", "label": "Updated", "sortable": true }
          ],
          "dataSource": "/api/users"
        }
      }
    ]
  }
}
