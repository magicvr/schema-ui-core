{
  "meta": {
    "pageId": "form-with-upload",
    "title": "Form with upload",
    "protocolVersion": "2.7",
    "requiredCapabilities": ["app.manifest", "app.navigation", "actions.upload", "form.controls.extended"]
  },
  "actions": {
    "uploadAttachment": {
      "type": "upload",
      "url": "/api/upload",
      "multiple": false,
      "onSuccess": { "behavior": "toast", "message": "上传成功" }
    }
  },
  "body": {
    "type": "section",
    "props": { "title": "Form with upload" },
    "children": [
      {
        "type": "text",
        "props": {
          "text": "ADR-0012 上传编排：选择文件即校验（accept/maxSize/multiple）并逐文件 multipart 上传；字段值取响应 url（优先）或 id。"
        }
      },
      {
        "type": "form",
        "id": "upload-form",
        "props": {
          "fields": [
            { "id": "title", "label": "Title (input)", "type": "input" },
            { "id": "attachment", "label": "Attachment (upload)", "type": "upload", "actionRef": "uploadAttachment" }
          ],
          "submitLabel": "Submit"
        }
      }
    ]
  }
}
