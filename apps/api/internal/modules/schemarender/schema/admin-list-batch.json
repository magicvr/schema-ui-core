{
  "meta": {
    "pageId": "admin-list-batch",
    "title": "List + batch",
    "protocolVersion": "2.7",
    "requiredCapabilities": [
      "app.manifest",
      "app.navigation",
      "permissions.inheritance",
      "actions.page.trigger",
      "actions.batch.request",
      "table.selection"
    ]
  },
  "actions": {
    "deleteUsers": {
      "type": "request",
      "method": "POST",
      "url": "/api/users/batch-delete",
      "onSuccess": {
        "behavior": "reload"
      },
      "onError": {
        "behavior": "toast",
        "message": "批量删除失败"
      }
    }
  },
  "body": {
    "type": "section",
    "props": {
      "title": "List + batch"
    },
    "children": [
      {
        "type": "text",
        "props": {
          "text": "ADR-0022 page multi-select + batch request (table.selection / actions.batch.request). Select rows to enable the toolbar batch button; success reloads and clears the selection.",
          "textKey": "schema.admin-list-batch.text.intro"
        }
      },
      {
        "type": "table",
        "id": "users-batch-table",
        "props": {
          "rowKey": "id",
          "selection": {
            "mode": "multiple"
          },
          "columns": [
            {
              "field": "id",
              "label": "ID",
              "labelKey": "schema.users.column.id"
            },
            {
              "field": "username",
              "label": "Username",
              "sortable": true,
              "labelKey": "schema.users.column.username"
            },
            {
              "field": "name",
              "label": "Name",
              "labelKey": "schema.users.column.name"
            }
          ],
          "dataSource": "/api/users",
          "toolbar": [
            {
              "key": "batchDelete",
              "label": "Batch delete",
              "actionRef": "deleteUsers",
              "requiresSelection": true,
              "confirm": "Delete the selected users?",
              "batchMapping": {
                "body": {
                  "ids": "$selection.keys"
                }
              },
              "labelKey": "schema.admin-list-batch.toolbar.batchDelete",
              "confirmKey": "schema.admin-list-batch.confirm.batchDelete"
            }
          ]
        }
      }
    ]
  }
}
