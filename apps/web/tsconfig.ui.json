{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist-lib/@schema-ui/ui",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"], "@schemas/*": ["../../docs/schemas/*"] },
    "types": ["vite/client", "node"]
  },
  "include": ["src/components/ui/index.ts","src/components/ui/*.ts*","src/components/data-table.tsx"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "**/test-fixtures/**"]
}