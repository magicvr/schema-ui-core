{
  "protocolVersion": "2.7",
  "requiredCapabilities": ["app.manifest", "app.navigation"],
  "app": {
    "appId": "schema-ui-core",
    "name": "Schema UI Core",
    "homePageRef": "overview",
    "description": "The schema-ui-core administration workspace."
  },
  "pages": [
    {
      "pageId": "overview",
      "title": "Overview",
      "schemaUrl": "/api/schema/overview",
      "route": "/overview"
    },
    {
      "pageId": "catalog",
      "title": "Catalog",
      "schemaUrl": "/api/schema/catalog",
      "route": "/catalog"
    },
    {
      "pageId": "activity",
      "title": "Activity",
      "schemaUrl": "/api/schema/activity",
      "route": "/activity"
    },
    {
      "pageId": "data-table",
      "title": "Data table",
      "schemaUrl": "/api/schema/data-table",
      "route": "/data-table"
    },
    {
      "pageId": "search-form-table",
      "title": "Search + table",
      "schemaUrl": "/api/schema/search-form-table",
      "route": "/search-form-table"
    },
    {
      "pageId": "list-edit-lifecycle",
      "title": "List + edit lifecycle",
      "schemaUrl": "/api/schema/list-edit-lifecycle",
      "route": "/list-edit-lifecycle"
    },
    {
      "pageId": "form-controls",
      "title": "Form controls",
      "schemaUrl": "/api/schema/form-controls",
      "route": "/form-controls"
    },
    {
      "pageId": "form-with-reactions",
      "title": "Form with reactions",
      "schemaUrl": "/api/schema/form-with-reactions",
      "route": "/form-with-reactions"
    },
    {
      "pageId": "settings",
      "title": "Settings",
      "schemaUrl": "/api/schema/settings",
      "route": "/settings"
    }
  ],
  "navigation": {
    "top": [
      {
        "pageRef": "overview",
        "label": "Overview",
        "icon": "dashboard"
      }
    ],
    "sidebar": [
      {
        "pageRef": "catalog",
        "label": "Catalog",
        "icon": "boxes"
      },
      {
        "label": "Examples",
        "icon": "folder",
        "items": [
          {
            "pageRef": "data-table",
            "label": "Data table",
            "icon": "table"
          },
          {
            "pageRef": "search-form-table",
            "label": "Search + table",
            "icon": "search"
          },
          {
            "pageRef": "list-edit-lifecycle",
            "label": "List + edit",
            "icon": "pen",
            "visibleWhen": {
              "when": "$context.features.menu_list_edit_lifecycle == true"
            }
          },
          {
            "pageRef": "form-controls",
            "label": "Form controls",
            "icon": "form"
          },
          {
            "pageRef": "form-with-reactions",
            "label": "Form with reactions",
            "icon": "reaction"
          }
        ]
      },
      {
        "label": "Workspace",
        "icon": "folder",
        "items": [
          {
            "pageRef": "activity",
            "label": "Activity",
            "icon": "activity"
          }
        ]
      }
    ],
    "user": [
      {
        "pageRef": "settings",
        "label": "Settings",
        "icon": "settings"
      }
    ]
  }
}
