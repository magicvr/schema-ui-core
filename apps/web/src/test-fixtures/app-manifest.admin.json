{
  "protocolVersion": "2.7",
  "requiredCapabilities": [
    "app.manifest",
    "app.navigation"
  ],
  "app": {
    "appId": "schema-ui-core",
    "name": "Schema UI Core",
    "homePageRef": "dashboard",
    "description": "The schema-ui-core administration workspace."
  },
  "pages": [
    {
      "pageId": "admin-list-batch",
      "title": "List + batch",
      "schemaUrl": "/api/schema/admin-list-batch",
      "route": "/admin-list-batch",
      "titleKey": "manifest.title.admin-list-batch"
    },
    {
      "pageId": "data-display",
      "title": "Data display",
      "schemaUrl": "/api/schema/data-display",
      "route": "/data-display",
      "titleKey": "manifest.title.data-display"
    },
    {
      "pageId": "overview",
      "title": "Overview",
      "schemaUrl": "/api/schema/overview",
      "route": "/overview",
      "titleKey": "manifest.title.overview"
    },
    {
      "pageId": "data-table",
      "title": "Data table",
      "schemaUrl": "/api/schema/data-table",
      "route": "/data-table",
      "titleKey": "manifest.title.data-table"
    },
    {
      "pageId": "search-form-table",
      "title": "Search + table",
      "schemaUrl": "/api/schema/search-form-table",
      "route": "/search-form-table",
      "titleKey": "manifest.title.search-form-table"
    },
    {
      "pageId": "form-controls",
      "title": "Form controls",
      "schemaUrl": "/api/schema/form-controls",
      "route": "/form-controls",
      "titleKey": "manifest.title.form-controls"
    },
    {
      "pageId": "form-with-reactions",
      "title": "Form with reactions",
      "schemaUrl": "/api/schema/form-with-reactions",
      "route": "/form-with-reactions",
      "titleKey": "manifest.title.form-with-reactions"
    },
    {
      "pageId": "form-with-upload",
      "title": "Form with upload",
      "schemaUrl": "/api/schema/form-with-upload",
      "route": "/form-with-upload",
      "titleKey": "manifest.title.form-with-upload"
    },
    {
      "pageId": "users",
      "title": "Users",
      "schemaUrl": "/api/schema/users",
      "route": "/users",
      "titleKey": "manifest.title.users"
    },
    {
      "pageId": "roles",
      "title": "Roles",
      "schemaUrl": "/api/schema/roles",
      "route": "/roles",
      "titleKey": "manifest.title.roles"
    },
    {
      "pageId": "settings",
      "title": "Settings",
      "schemaUrl": "/api/schema/settings",
      "route": "/settings",
      "titleKey": "manifest.title.settings"
    },
    {
      "pageId": "activity",
      "title": "Activity",
      "schemaUrl": "/api/schema/activity",
      "route": "/activity",
      "titleKey": "manifest.title.activity"
    },
    {
      "pageId": "dashboard",
      "title": "Dashboard",
      "schemaUrl": "/api/schema/dashboard",
      "route": "/dashboard",
      "titleKey": "manifest.title.dashboard"
    },
    {
      "pageId": "account",
      "title": "Account",
      "schemaUrl": "/api/schema/account",
      "route": "/account",
      "titleKey": "manifest.title.account"
    },
    {
      "pageId": "notifications",
      "title": "Notifications",
      "schemaUrl": "/api/schema/notifications",
      "route": "/notifications",
      "titleKey": "manifest.title.notifications"
    }
  ],
  "navigation": {
    "top": [
      {
        "pageRef": "overview",
        "label": "Overview",
        "icon": "dashboard",
        "labelKey": "manifest.nav.overview"
      }
    ],
    "sidebar": [
      {
        "pageRef": "dashboard",
        "label": "Dashboard",
        "icon": "dashboard",
        "labelKey": "manifest.nav.dashboard",
        "visibleWhen": {
          "when": "$context.features.menu_dashboard == true"
        }
      },
      {
        "label": "Examples",
        "icon": "folder",
        "items": [
          {
            "pageRef": "data-table",
            "label": "Data table",
            "icon": "table",
            "labelKey": "manifest.nav.data-table"
          },
          {
            "pageRef": "admin-list-batch",
            "label": "List + batch",
            "icon": "batch",
            "labelKey": "manifest.nav.admin-list-batch"
          },
          {
            "pageRef": "data-display",
            "label": "Data display",
            "icon": "chart",
            "labelKey": "manifest.nav.data-display"
          },
          {
            "pageRef": "search-form-table",
            "label": "Search + table",
            "icon": "search",
            "labelKey": "manifest.nav.search-form-table"
          },
          {
            "pageRef": "form-controls",
            "label": "Form controls",
            "icon": "form",
            "labelKey": "manifest.nav.form-controls"
          },
          {
            "pageRef": "form-with-reactions",
            "label": "Form with reactions",
            "icon": "reaction",
            "labelKey": "manifest.nav.form-with-reactions"
          },
          {
            "pageRef": "form-with-upload",
            "label": "Form with upload",
            "icon": "upload",
            "labelKey": "manifest.nav.form-with-upload"
          }
        ],
        "labelKey": "manifest.nav.examples"
      },
      {
        "label": "Admin",
        "icon": "folder",
        "items": [
          {
            "pageRef": "users",
            "label": "Users",
            "icon": "user",
            "visibleWhen": {
              "when": "$context.features.menu_users == true"
            },
            "labelKey": "manifest.nav.users"
          },
          {
            "pageRef": "roles",
            "label": "Roles",
            "icon": "user",
            "visibleWhen": {
              "when": "$context.features.menu_roles == true"
            },
            "labelKey": "manifest.nav.roles"
          },
          {
            "pageRef": "activity",
            "label": "Activity",
            "icon": "activity",
            "visibleWhen": {
              "when": "$context.features.menu_activity == true"
            },
            "labelKey": "manifest.nav.activity"
          }
        ],
        "labelKey": "manifest.nav.admin"
      }
    ],
    "user": [
      {
        "pageRef": "settings",
        "label": "Settings",
        "icon": "settings",
        "visibleWhen": {
          "when": "$context.features.menu_settings == true"
        },
        "labelKey": "manifest.nav.settings"
      },
      {
        "pageRef": "account",
        "label": "Account",
        "icon": "user",
        "labelKey": "manifest.nav.account",
        "visibleWhen": {
          "when": "$context.features.menu_account == true"
        }
      },
      {
        "pageRef": "notifications",
        "label": "Notifications",
        "icon": "bell",
        "labelKey": "manifest.nav.notifications",
        "visibleWhen": {
          "when": "$context.features.menu_notifications == true"
        }
      }
    ]
  }
}
